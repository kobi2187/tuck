# A frame call inside an `if` condition is not cut yet (#216): refused by
# name, never run wrong. Bind it to a `let` first.
fn twice({n: int}) -> {v: int} [io]:
  {ms: 1} pause
  return {v: n * 2}

extern:
  fn pause({ms: int}) [io]

task check({n: int}) -> {r: int} [io]:
  if ({n: n} twice).v > 3:
    return {r: 1}
  return {r: 0}

fn main() -> int [io]:
  let r = {n: 2} check
  return r.r
