# Only the paths that run, in the order they run (audit C6/C7). A call on an
# untaken branch, an unmatched arm or the right of a decided `and`/`or` does
# not run; an operand left of a pause is read before it — on both flags.
import console
import str
import time

actor Counter [queue: 8]:
  n: int = 0
  on bump():
    n = n + 1

fn say({text: str}) [io]:
  {text: text} console::printLine

fn tick({tag: str, v: int}) -> int [io]:
  {text: "tick " + tag} say
  return v

fn yes({tag: str}) -> bool [io]:
  {text: "yes " + tag} say
  return true

fn no({tag: str}) -> bool [io]:
  {text: "no " + tag} say
  return false

fn nap({ms: u32}) -> int [io]:
  {ms: ms} time::sleepMs
  return 1

task bumper({k: int}) -> {r: int} [io]:
  let w = {ms: 5} nap
  Counter send bump {}
  return {r: 0}

task paths({k: int}) -> {r: int} [io]:
  let v = if k > 5: {tag: "then", v: 1} tick else: 0
  let w = match k:
    1: {tag: "arm1", v: 1} tick
    2: {tag: "arm2", v: 2} tick
    _: 9
  if {tag: "L1"} no and {tag: "R1"} yes:
    {text: "bad"} say
  if {tag: "L2"} yes or {tag: "R2"} yes:
    {text: "ok"} say
  {k: 7} bumper
  let s = Counter.n + {ms: 50} nap
  {text: "read " + s.toStr} say
  return {r: v + w + s}

fn main() -> int [io]:
  let r = {k: 1} paths
  return r.r
