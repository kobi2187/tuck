# Fault injection: simulate a dropped interrupt, verify safeState is reached.
extern [impl: nim "./host_sim/print_shim", odin "./host_sim", d "./host_sim/print_shim"]:
  fn say({text: str}) -> void
extern [impl: nim "./host_sim/fault_shim", odin "./host_sim", d "./host_sim/fault_shim"]:
  fn faultIsrDrop({}) -> bool [irq_safe, no_alloc]

register LED at 0x40000000:
  VALUE: bits 0..7 [read, write]

fn safeState({}) -> void:
  LED.VALUE = 0
  return

fn handler() [irq, irq_safe, no_alloc]:
  # Normally: set LED = 1 and signal a task.
  # With fault injection: simulate a dropped interrupt — do nothing.
  if not {} faultIsrDrop:
    LED.VALUE = 1
  return

fn main() -> int:
  # Start in safe state.
  {} safeState
  # Simulate the ISR firing.
  {} handler
  # If the interrupt was dropped, LED should still be 0 (safe state).
  if LED.VALUE == 0:
    {text: "FAULT_SAFE_OK\n"} say
  else:
    {text: "FAULT_SAFE_BAD\n"} say
  return 0