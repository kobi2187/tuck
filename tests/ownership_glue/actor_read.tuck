import scheduler
import seq

type Bag:
  xs: Seq[int]
  n: int

fn grow({b: Bag}) -> Bag:
  var it = b.xs
  it = {items: it, value: b.n} push
  return {xs: it, n: b.n + 1} Bag

actor Keeper [queue: 16]:
  st: Bag = {xs: [], n: 0} Bag
  ready: bool = false
  on init({n: int}):
    st = {xs: [7], n: 0} Bag
  on peek({n: int}):
    let g = {b: st} grow
    ready = true

fn done() -> bool:
  return Keeper.ready

fn main() -> int:
  Keeper send init {n: 0}
  Keeper send peek {n: 0}
  Keeper.waitUntil {pred: :done}
  let b = Keeper.st
  return b.xs[0] + b.n
