type Expr:
  | Num({value: int})
  | Neg({operand: Expr})
  | Add({left: Expr, right: Expr})

fn eval({e: Expr}) -> int:
  match e:
    Num: return e.value
    Neg: return 0 - {e: e.operand} eval
    Add: return {e: e.left} eval + {e: e.right} eval

fn main() -> int:
  var i = 0
  for i < 100:
    let n = Expr.Num {value: 3}
    let tree = Expr.Add {left: n, right: Expr.Neg {operand: n}}
    if {e: tree} eval != 0:
      return 9
    i = i + 1
  return 0
