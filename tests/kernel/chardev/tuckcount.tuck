# A Linux character device whose answers are Tuck code (docs/kernel/).
#
# The C half (chardev.c, compiled by kbuild against the kernel headers)
# registers /dev/tuckcount; every read calls back into `answer` with the
# read's number, and the device returns what it says: the n-th read gives
# n squared. `main` is the module's init (0 loads it, a negative errno
# refuses), `unload` its exit.

import console
import str

extern [c, header: "chardev.h", lib: "chardev.c"]:
  fnsig TcReader = {n: i32} -> i32
  fn tc_register({cb: TcReader}) -> i32
  fn tc_unregister() -> void

fn answer({n: i32}) -> i32:
  return n * n

fn main() -> int:
  let rc = {cb: :answer} tc_register
  if rc != 0:
    return rc ^int
  {text: "tuckcount: /dev/tuckcount is up"} console::printLine
  return 0

fn unload() [io]:
  tc_unregister
  {text: "tuckcount: removed"} console::printLine
