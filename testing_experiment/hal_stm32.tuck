# Reference HAL for STM32F103C8 (Blue Pill) — real MMIO addresses.
# These `register` decls are NOT used by the stages above (which go through
# the extern shim so they run on the host sim). They document the real
# addresses for the porting step.

register GPIOC_ODR at 0x4001100C:
  ODR13: bit 13 [read, write]

register GPIOC_CRH at 0x40011004:
  MODE13: bits 20..21 [read, write]
  CNF13:  bits 22..23 [read, write]

register RCC_APB2ENR at 0x40021018:
  IOPCEN: bit 4 [read, write]

register SYSTICK_CSR at 0xE000E010:
  ENABLE:   bit 0  [read, write]
  TICKINT:  bit 1  [read, write]
  COUNTFLAG: bit 16 [read]

register SYSTICK_RVR at 0xE000E014:
  RELOAD: bits 0..23 [read, write]

register SYSTICK_CVR at 0xE000E018:
  CURRENT: bits 0..23 [read, write]
