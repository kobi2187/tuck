# guess — guess the number.
#
#   guess [--max N] [--seed N]
#
# The program thinks of a number from 1 to N (100) and answers each guess,
# one per line on stdin, with "higher" or "lower" until it is found.
import console
import seq
import str
import text
import convert
import random
import cli

fn command() -> Command:
  let max1 = {name: "max", shortName: "m", kind: ANumber, help: "the largest number (100)", required: false} spec
  let seed = {name: "seed", shortName: "s", kind: ANumber, help: "replay a game", required: false} spec
  let args: Seq[ArgSpec] = [max1, seed]
  let none1: Seq[Command] = []
  return {name: "guess", help: "guess the number", args: args, subcommands: none1} Command

fn main() -> int [io, io: sys, io: console]:
  let argv = commandLine
  let parsed = {c: command, argv: argv} tryParse
  if not parsed.ok:
    let usage = {c: command} usageOf
    {text: usage} printLine
    return 2
  let a = parsed.value
  var top = 100
  let m = {a: a, name: "max"} numberOf
  if m.ok:
    top = {value: m.value} int
  var gen = newDiceFromOs
  let seed = {a: a, name: "seed"} numberOf
  if seed.ok:
    let s = {value: seed.value} u64
    gen = {seed: s} newDice
  let r = {d: gen, low: 1, high: top} rollRange
  if not r.ok:
    return 2
  let secret = r.value.value
  let limit = {value: top} toStr
  {text: "I'm thinking of a number from 1 to " + limit + "."} printLine
  var tries = 0
  for true:
    let input = readLine
    if not input.ok:
      let was = {value: secret} toStr
      {text: "The number was " + was + "."} printLine
      return 1
    let line = {t: input.value.line} trim
    let n = {t: line} parseInt
    if not n.ok:
      {text: "That is not a number: " + line} printLine
    else:
      tries = tries + 1
      let g = {value: n.value} int
      if g < secret:
        {text: "Higher."} printLine
      elif g > secret:
        {text: "Lower."} printLine
      else:
        let t = {value: tries} toStr
        {text: "Got it in " + t + " tries!"} printLine
        return 0
  return 0
