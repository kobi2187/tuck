# wordfreq — the most common words in a text.
#
#   wordfreq FILE [--top N] [--min-length N]
#
# Words are runs of letters, apostrophes inside a word included ("don't"),
# compared ignoring ASCII case. Ties are broken alphabetically, so the output
# is stable. The classic first program over a dictionary and a sort.
import console
import seq
import str
import text
import fs
import cli
import map
import iter

type Count:
  word: str
  n: int

fn command() -> Command:
  let top = {name: "top", shortName: "t", kind: ANumber, help: "how many to show (10)", required: false} spec
  let minLen = {name: "min-length", shortName: "m", kind: ANumber, help: "ignore shorter words (1)", required: false} spec
  let args: Seq[ArgSpec] = [top, minLen]
  let none1: Seq[Command] = []
  return {name: "wordfreq", help: "the most common words in a file", args: args, subcommands: none1} Command

fn isLetter({b: u8}) -> bool:
  return (b >= 65 and b <= 90) or (b >= 97 and b <= 122)

# The words of `t`, lower-cased.
fn wordsOf({t: str}) -> Seq[str]:
  var out: Seq[str] = []
  var start = -1
  let n = {t: t} byteCount
  for i in 0 .. n:
    var inWord = false
    if i < n:
      let b = {t: t, index: i} byteAt
      inWord = {b: b} isLetter
      # an apostrophe between two letters stays in the word
      if b == 39 and start >= 0 and i + 1 < n:
        let next = {t: t, index: i + 1} byteAt
        inWord = {b: next} isLetter
    if inWord and start < 0:
      start = i
    elif not inWord and start >= 0:
      let w = {t: t, start: start, stop: i} slice
      if w.ok:
        let lower = {t: w.value} toLowerAscii
        out = {items: out, value: lower} push
      start = -1
  return out

# More frequent first; equally frequent in alphabetical order.
fn before({a: Count, b: Count}) -> bool:
  if a.n != b.n:
    return a.n > b.n
  return a.word < b.word

fn tally({words: Seq[str], minLen: int}) -> Seq[Count]:
  var counts: Table[str, int] = {entries: []} Table
  for i in 0 .. words.len - 1:
    let w = words[i]
    if {t: w} byteCount >= minLen:
      let seen = {t: counts, key: w} get
      var n = 1
      if seen.ok:
        n = seen.value + 1
      counts = {t: counts, key: w, value: n} set
  var out: Seq[Count] = []
  let ps = {t: counts} pairs
  for i in 0 .. ps.len - 1:
    let c = {word: ps[i].key, n: ps[i].value} Count
    out = {items: out, value: c} push
  return {items: out, before: :before} sortBy

fn main() -> int [io, io: sys, io: fs, io: console]:
  let argv = commandLine
  let parsed = {c: command, argv: argv} tryParse
  if not parsed.ok:
    let usage = {c: command} usageOf
    {text: usage} printLine
    return 2
  let a = parsed.value
  if a.positional.len != 1:
    let usage = {c: command} usageOf
    {text: usage} printLine
    return 2
  let file = {path: a.positional[0]} readFile
  if not file.ok:
    {text: "wordfreq: cannot read " + a.positional[0]} printLine
    return 1
  var top = 10
  let t = {a: a, name: "top"} numberOf
  if t.ok:
    top = {value: t.value} int
  var minLen = 1
  let m = {a: a, name: "min-length"} numberOf
  if m.ok:
    minLen = {value: m.value} int
  let words = {t: file.value.content} wordsOf
  let ranked = {words: words, minLen: minLen} tally
  for i in 0 .. ranked.len - 1:
    if i < top:
      let n = {value: ranked[i].n} toStr
      {text: n + " " + ranked[i].word} printLine
  return 0
