# csvstats — a summary of every column of a CSV file, like pandas' describe().
#
#   csvstats [--sep ;] < data.csv
#
# The first row names the columns. A column whose filled cells are all numbers
# gets min, max, mean and median (to two places); any other column gets how
# many distinct values it holds and the most common one. Empty cells are
# skipped and counted as missing. Exit 2 when stdin is not CSV.
import console
import seq
import str
import text
import convert
import cli
import encoding
import math

type Column:
  name: str
  cells: Seq[str]

# --- reading ------------------------------------------------------------------------
fn readAll() -> str [io: console]:
  var lines: Seq[str] = []
  for true:
    let got = readLine
    if not got.ok:
      return {parts: lines, sep: "\n"} joinStr
    lines = {items: lines, value: got.value.line} push
  return ""

fn cellOf({row: Seq[str], index: int}) -> str:
  if index < row.len:
    return {t: row[index]} trim
  return ""

# The rows below the header, turned on their side: one Column per header name.
fn columnsOf({rows: Seq[Seq[str]]}) -> Seq[Column]:
  var out: Seq[Column] = []
  let header = rows[0]
  for c in 0 .. header.len - 1:
    var cells: Seq[str] = []
    for r in 1 .. rows.len - 1:
      let v = {row: rows[r], index: c} cellOf
      cells = {items: cells, value: v} push
    let name = {t: header[c]} trim
    let col = {name: name, cells: cells} Column
    out = {items: out, value: col} push
  return out

fn filled({cells: Seq[str]}) -> Seq[str]:
  var out: Seq[str] = []
  for i in 0 .. cells.len - 1:
    if cells[i] != "":
      out = {items: out, value: cells[i]} push
  return out

# Every cell as a number, or none when one of them is not.
fn numbersOf({cells: Seq[str]}) -> Seq[f64]?:
  var out: Seq[f64] = []
  for i in 0 .. cells.len - 1:
    let n = {t: cells[i]} parseFloat
    if not n.ok:
      return none
    out = {items: out, value: n.value} push
  return out

# --- formatting ---------------------------------------------------------------------
# Two places, rounded half away from zero, through an exact Decimal so every
# backend prints the same digits.
fn twoPlaces({x: f64}) -> str:
  var scaled = x * 100.0
  if scaled < 0.0:
    scaled = scaled - 0.5
  else:
    scaled = scaled + 0.5
  let whole = scaled ~int
  let units = {value: whole} i64
  let d = {units: units, scale: 2} dec
  return {d: d} decToStr

fn wholeText({n: int}) -> str:
  return {value: n} toStr

# --- one column ---------------------------------------------------------------------
fn numericRow({name: str, have: int, missing: int, xs: Seq[f64]}) -> Seq[str]:
  let s = {samples: xs} describe
  let med = {samples: xs, p: 50.0} percentile
  var median = ""
  if med.ok:
    median = {x: med.value} twoPlaces
  let lo = {x: s.min} twoPlaces
  let hi = {x: s.max} twoPlaces
  let mean = {x: s.mean} twoPlaces
  let h = {n: have} wholeText
  let m = {n: missing} wholeText
  let row: Seq[str] = [name, "number", h, m, lo, hi, mean, median, "", ""]
  return row

# How many distinct values, and the most common one (the first seen on a tie).
fn tally({cells: Seq[str]}) -> {kinds: int, top: str}:
  var seen: Seq[str] = []
  var hits: Seq[int] = []
  for i in 0 .. cells.len - 1:
    var at = 0 - 1
    for j in 0 .. seen.len - 1:
      if seen[j] == cells[i]:
        at = j
    if at < 0:
      seen = {items: seen, value: cells[i]} push
      hits = {items: hits, value: 1} push
    else:
      hits[at] = hits[at] + 1
  var best = 0
  for j in 1 .. seen.len - 1:
    if hits[j] > hits[best]:
      best = j
  if seen.len == 0:
    return {kinds: 0, top: ""}
  return {kinds: seen.len, top: seen[best]}

fn textRow({name: str, have: int, missing: int, cells: Seq[str]}) -> Seq[str]:
  let t = {cells: cells} tally
  let h = {n: have} wholeText
  let m = {n: missing} wholeText
  let d = {n: t.kinds} wholeText
  let row: Seq[str] = [name, "text", h, m, "", "", "", "", d, t.top]
  return row

fn rowFor({col: Column}) -> Seq[str]:
  let present = {cells: col.cells} filled
  let have = present.len
  let missing = col.cells.len - have
  let xs = {cells: present} numbersOf
  if xs.ok:
    if have > 0:
      return {name: col.name, have: have, missing: missing, xs: xs.value} numericRow
  return {name: col.name, have: have, missing: missing, cells: present} textRow

# --- the program --------------------------------------------------------------------
fn command() -> Command:
  let sep = {name: "sep", shortName: "s", kind: AText, help: "the field separator (,)", required: false} spec
  let args: Seq[ArgSpec] = [sep]
  let noSubs: Seq[Command] = []
  return {name: "csvstats", help: "summarise the columns of a CSV file", args: args, subcommands: noSubs} Command

fn main() -> int [io, io: sys, io: console]:
  let argv = commandLine
  let parsed = {c: command, argv: argv} tryParse
  if not parsed.ok:
    let usage = {c: command} usageOf
    {text: usage} printLine
    return 2
  var sep = ","
  let given = {a: parsed.value, name: "sep"} textOf
  if given.ok:
    sep = given.value
  let input = readAll
  let rows = {t: input, sep: sep} parseCsv
  let refusal = "csvstats: stdin is not CSV with a header and a row"
  if not rows.ok:
    {text: refusal} printLine
    return 2
  if rows.value.len < 2:
    {text: refusal} printLine
    return 2
  let cols = {rows: rows.value} columnsOf
  var table: Seq[Seq[str]] = []
  for i in 0 .. cols.len - 1:
    let r = {col: cols[i]} rowFor
    table = {items: table, value: r} push
  let headers: Seq[str] = ["column", "type", "filled", "missing", "min", "max", "mean", "median", "distinct", "top"]
  let out = {headers: headers, rows: table} renderTable
  {text: out} printLine
  return 0
