# diffpatch — the differences between two text files, as a unified diff.
#
#   diffpatch OLD NEW [--context N]
#
# The output is what `diff -u` prints (less the timestamps), so `patch`
# applies it: `---`/`+++` naming the files, then one `@@ -a,b +c,d @@` hunk
# per run of changes with N lines of context around it (3). Exit 0 when the
# files are the same, 1 when they differ, 2 when one cannot be read.
#
# The match is a longest common subsequence over whole lines, a table of
# (OLD lines + 1) x (NEW lines + 1) cells: fine for the files a person edits,
# not for a log of a million lines.
import console
import seq
import str
import text
import convert
import cli
import fs
import files

# One line of the edit: kept (" "), removed ("-") or added ("+"), with how many
# lines of each file came before it.
type Op:
  mark: str
  body: str
  oldAt: int
  newAt: int

# --- matching -----------------------------------------------------------------------
fn larger({a: int, b: int}) -> int:
  if a > b:
    return a
  return b

# Cell (i, j) holds the longest common subsequence of left[i..] and right[j..].
fn lcsTable({left: Seq[str], right: Seq[str]}) -> Seq[int]:
  let w = right.len + 1
  var t: Seq[int] = []
  for k in 0 .. (left.len + 1) * w - 1:
    t = {items: t, value: 0} push
  var i = left.len - 1
  for i >= 0:
    var j = right.len - 1
    for j >= 0:
      if left[i] == right[j]:
        t[i * w + j] = t[(i + 1) * w + j + 1] + 1
      else:
        t[i * w + j] = {a: t[(i + 1) * w + j], b: t[i * w + j + 1]} larger
      j = j - 1
    i = i - 1
  return t

fn op({mark: str, body: str, i: int, j: int}) -> Op:
  return {mark: mark, body: body, oldAt: i, newAt: j} Op

# The edit, front to back. On a tie a removal goes first, so a changed line
# reads as its old text then its new one.
fn editOf({left: Seq[str], right: Seq[str]}) -> Seq[Op]:
  let t = {left: left, right: right} lcsTable
  let w = right.len + 1
  var ops: Seq[Op] = []
  var i = 0
  var j = 0
  for i < left.len and j < right.len:
    if left[i] == right[j]:
      let o = {mark: " ", body: left[i], i: i, j: j} op
      ops = {items: ops, value: o} push
      i = i + 1
      j = j + 1
    elif t[(i + 1) * w + j] >= t[i * w + j + 1]:
      let o = {mark: "-", body: left[i], i: i, j: j} op
      ops = {items: ops, value: o} push
      i = i + 1
    else:
      let o = {mark: "+", body: right[j], i: i, j: j} op
      ops = {items: ops, value: o} push
      j = j + 1
  for i < left.len:
    let o = {mark: "-", body: left[i], i: i, j: j} op
    ops = {items: ops, value: o} push
    i = i + 1
  for j < right.len:
    let o = {mark: "+", body: right[j], i: i, j: j} op
    ops = {items: ops, value: o} push
    j = j + 1
  return ops

# --- hunks --------------------------------------------------------------------------
fn changesIn({ops: Seq[Op]}) -> Seq[int]:
  var at: Seq[int] = []
  for k in 0 .. ops.len - 1:
    if ops[k].mark != " ":
      at = {items: at, value: k} push
  return at

# `start,size`, or just `start` for one line, as diff writes it. An empty
# range names the line before it.
fn rangeText({before: int, size: int}) -> str:
  var start = before + 1
  if size == 0:
    start = before
  let s = {value: start} toStr
  if size == 1:
    return s
  let n = {value: size} toStr
  return s + "," + n

fn hunkText({ops: Seq[Op], first: int, last: int}) -> str:
  var oldSize = 0
  var newSize = 0
  var lines: Seq[str] = []
  for k in first .. last:
    if ops[k].mark != "+":
      oldSize = oldSize + 1
    if ops[k].mark != "-":
      newSize = newSize + 1
    lines = {items: lines, value: ops[k].mark + ops[k].body} push
  let o = {before: ops[first].oldAt, size: oldSize} rangeText
  let n = {before: ops[first].newAt, size: newSize} rangeText
  let head = "@@ -" + o + " +" + n + " @@"
  let body = {parts: lines, sep: "\n"} joinStr
  return head + "\n" + body

fn clampTo({x: int, low: int, high: int}) -> int:
  if x < low:
    return low
  if x > high:
    return high
  return x

# Changes closer than twice the context share a hunk.
fn hunksOf({ops: Seq[Op], around: int}) -> Seq[str]:
  let at = {ops: ops} changesIn
  var out: Seq[str] = []
  var c = 0
  for c < at.len:
    var last = at[c]
    var d = c + 1
    for d < at.len and at[d] - last - 1 <= 2 * around:
      last = at[d]
      d = d + 1
    let first = {x: at[c] - around, low: 0, high: ops.len - 1} clampTo
    let stop = {x: last + around, low: 0, high: ops.len - 1} clampTo
    let h = {ops: ops, first: first, last: stop} hunkText
    out = {items: out, value: h} push
    c = d
  return out

# --- the program --------------------------------------------------------------------
fn command() -> Command:
  let ctx = {name: "context", shortName: "c", kind: ANumber, help: "lines around a change (3)", required: false} spec
  let args: Seq[ArgSpec] = [ctx]
  let noSubs: Seq[Command] = []
  return {name: "diffpatch", help: "a unified diff of two files", args: args, subcommands: noSubs} Command

fn linesOf({path: str}) -> Seq[str]? [io: fs]:
  let got = {path: path} readLines
  if not got.ok:
    return none
  return got.value.lines

fn main() -> int [io, io: sys, io: console, io: fs]:
  let argv = commandLine
  let parsed = {c: command, argv: argv} tryParse
  if not parsed.ok:
    let usage = {c: command} usageOf
    {text: usage} printLine
    return 2
  let a = parsed.value
  if a.positional.len != 2:
    {text: "diffpatch: name two files"} printLine
    return 2
  var around = 3
  let given = {a: a, name: "context"} numberOf
  if given.ok:
    around = {value: given.value} int
  let oldName = a.positional[0]
  let newName = a.positional[1]
  let left = {path: oldName} linesOf
  if not left.ok:
    {text: "diffpatch: cannot read " + oldName} printLine
    return 2
  let right = {path: newName} linesOf
  if not right.ok:
    {text: "diffpatch: cannot read " + newName} printLine
    return 2
  let ops = {left: left.value, right: right.value} editOf
  let hunks = {ops: ops, around: around} hunksOf
  if hunks.len == 0:
    return 0
  {text: "--- " + oldName} printLine
  {text: "+++ " + newName} printLine
  for k in 0 .. hunks.len - 1:
    {text: hunks[k]} printLine
  return 1
