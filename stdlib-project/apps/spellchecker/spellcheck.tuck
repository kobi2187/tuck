# spellcheck — the words on stdin that a dictionary does not know.
#
#   spellcheck [--words FILE] [--distance N] < text.txt
#
# The dictionary is a word list, one word per line (words.txt by default).
# Each unknown word is reported as `line:column word`, with the closest known
# word when one is at most N edits away (2): `3:9 quik -> quick`. A word is a
# run of letters, with apostrophes inside it (`don't`), compared in lower
# case. Exit 0 when every word is known, 1 when one is not, 2 when the
# dictionary cannot be read.
import console
import seq
import str
import text
import convert
import cli
import fs
import files

type Word:
  body: str
  column: int

# --- words --------------------------------------------------------------------------
fn isLetter({b: u8}) -> bool:
  return (b >= 97 and b <= 122) or (b >= 65 and b <= 90)

fn isApostrophe({b: u8}) -> bool:
  return b == 39

# Where the word that starts at `start` ends. An apostrophe belongs to it only
# between two letters.
fn wordEnd({t: str, start: int}) -> int:
  let n = {t: t} byteCount
  var j = start
  for j < n:
    let b = {t: t, index: j} byteAt
    if {b: b} isLetter:
      j = j + 1
    elif {b: b} isApostrophe and j + 1 < n:
      let after = {t: t, index: j + 1} byteAt
      if not ({b: after} isLetter):
        return j
      j = j + 1
    else:
      return j
  return j

fn wordsIn({line: str}) -> Seq[Word]:
  var out: Seq[Word] = []
  let n = {t: line} byteCount
  var i = 0
  for i < n:
    let b = {t: line, index: i} byteAt
    if {b: b} isLetter:
      let stop = {t: line, start: i} wordEnd
      let piece = {t: line, start: i, stop: stop} slice
      if piece.ok:
        let lower = {t: piece.value} toLowerAscii
        let w = {body: lower, column: i + 1} Word
        out = {items: out, value: w} push
      i = stop
    else:
      i = i + 1
  return out

# --- the dictionary -----------------------------------------------------------------
fn knows({dict: Seq[str], word: str}) -> bool:
  for i in 0 .. dict.len - 1:
    if dict[i] == word:
      return true
  return false

fn smallest({a: int, b: int, c: int}) -> int:
  var m = a
  if b < m:
    m = b
  if c < m:
    m = c
  return m

fn letterAt({t: str, i: int}) -> u8:
  return {t: t, index: i} byteAt

# Edits from `a` to `b`: insert, delete or replace one letter, or swap two
# neighbours (`wrold` is one edit from `world`). Three rows at a time.
fn distance({a: str, b: str}) -> int:
  let n = {t: a} byteCount
  let m = {t: b} byteCount
  var older: Seq[int] = []
  var prev: Seq[int] = []
  for j in 0 .. m:
    prev = {items: prev, value: j} push
  for i in 1 .. n:
    var row: Seq[int] = []
    row = {items: row, value: i} push
    for j in 1 .. m:
      var cost = 1
      let x = {t: a, i: i - 1} letterAt
      let y = {t: b, i: j - 1} letterAt
      if x == y:
        cost = 0
      var best = {a: prev[j] + 1, b: row[j - 1] + 1, c: prev[j - 1] + cost} smallest
      if i > 1 and j > 1:
        let xBack = {t: a, i: i - 2} letterAt
        let yBack = {t: b, i: j - 2} letterAt
        if x == yBack and xBack == y and older[j - 2] + 1 < best:
          best = older[j - 2] + 1
      row = {items: row, value: best} push
    older = prev
    prev = row
  return prev[m]

# The closest dictionary word within `most` edits, the first one on a tie.
fn guessFor({dict: Seq[str], word: str, most: int}) -> str?:
  var best = most + 1
  var found = ""
  for i in 0 .. dict.len - 1:
    let d = {a: word, b: dict[i]} distance
    if d < best:
      best = d
      found = dict[i]
  if found == "":
    return none
  return found

fn dictionaryAt({path: str}) -> Seq[str]? [io: fs]:
  let got = {path: path} readLines
  if not got.ok:
    return none
  var out: Seq[str] = []
  for i in 0 .. got.value.lines.len - 1:
    let w = {t: got.value.lines[i]} trim
    if w != "":
      let lower = {t: w} toLowerAscii
      out = {items: out, value: lower} push
  return out

# --- the program --------------------------------------------------------------------
fn command() -> Command:
  let words = {name: "words", shortName: "w", kind: AText, help: "the word list (words.txt)", required: false} spec
  let far = {name: "distance", shortName: "d", kind: ANumber, help: "furthest suggestion, in edits (2)", required: false} spec
  let args: Seq[ArgSpec] = [words, far]
  let noSubs: Seq[Command] = []
  return {name: "spellcheck", help: "report the words a dictionary does not know", args: args, subcommands: noSubs} Command

fn report({w: Word, row: int, guess: str?}) -> str:
  let r = {value: row} toStr
  let c = {value: w.column} toStr
  let head = r + ":" + c + " " + w.body
  if guess.ok:
    return head + " -> " + guess.value
  return head

fn main() -> int [io, io: sys, io: console, io: fs]:
  let argv = commandLine
  let parsed = {c: command, argv: argv} tryParse
  if not parsed.ok:
    let usage = {c: command} usageOf
    {text: usage} printLine
    return 2
  var path = "words.txt"
  let given = {a: parsed.value, name: "words"} textOf
  if given.ok:
    path = given.value
  var most = 2
  let far = {a: parsed.value, name: "distance"} numberOf
  if far.ok:
    most = {value: far.value} int
  let dict = {path: path} dictionaryAt
  if not dict.ok:
    {text: "spellcheck: cannot read " + path} printLine
    return 2
  var misses = 0
  var row = 0
  for true:
    let got = readLine
    if not got.ok:
      if misses > 0:
        return 1
      return 0
    row = row + 1
    let words = {line: got.value.line} wordsIn
    for i in 0 .. words.len - 1:
      if not {dict: dict.value, word: words[i].body} knows:
        let guess = {dict: dict.value, word: words[i].body, most: most} guessFor
        let line = {w: words[i], row: row, guess: guess} report
        {text: line} printLine
        misses = misses + 1
  return 0
