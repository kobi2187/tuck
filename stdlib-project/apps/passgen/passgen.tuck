# passgen — random passwords.
#
#   passgen [--length N] [--count N] [--no-symbols] [--seed N]
#
# Every password has at least one lower-case letter, one upper-case letter, one
# digit and (unless --no-symbols) one symbol, placed at random. `--seed`
# replays a run; without it the OS seeds the generator. For real secrets use a
# CSPRNG (std.crypto): this is the classic exercise, not a vault.
import console
import seq
import str
import random
import cli

fn command() -> Command:
  let length = {name: "length", shortName: "l", kind: ANumber, help: "characters per password (16)", required: false} spec
  let count1 = {name: "count", shortName: "c", kind: ANumber, help: "how many passwords (1)", required: false} spec
  let plain = {name: "no-symbols", shortName: "n", kind: AFlag, help: "letters and digits only", required: false} spec
  let seed = {name: "seed", shortName: "s", kind: ANumber, help: "replay a run", required: false} spec
  let args: Seq[ArgSpec] = [length, count1, plain, seed]
  let none1: Seq[Command] = []
  return {name: "passgen", help: "random passwords", args: args, subcommands: none1} Command

fn classes({symbols: bool}) -> Seq[str]:
  var out: Seq[str] = ["abcdefghijklmnopqrstuvwxyz", "ABCDEFGHIJKLMNOPQRSTUVWXYZ", "0123456789"]
  if symbols:
    out = {items: out, value: "!@#$%^&*-_=+?"} push
  return out

type Drawn:
  d: Dice
  text: str

# One character of `from1`.
fn pickChar({d: Dice, from1: str}) -> Drawn:
  let n = {t: from1} byteCount
  let r = {d: d, low: 0, high: n - 1} rollRange
  if not r.ok:
    return {d: d, text: ""} Drawn
  let c = {s: from1, index: r.value.value} charAt
  return {d: r.value.d, text: c} Drawn

fn password({d: Dice, length: int, symbols: bool}) -> Drawn:
  let cs = {symbols: symbols} classes
  let all = {parts: cs, sep: ""} joinStr
  var gen = d
  var chars: Seq[str] = []
  # one of each class first, then the rest from all of them
  for i in 0 .. cs.len - 1:
    let p = {d: gen, from1: cs[i]} pickChar
    gen = p.d
    chars = {items: chars, value: p.text} push
  for chars.len < length:
    let p = {d: gen, from1: all} pickChar
    gen = p.d
    chars = {items: chars, value: p.text} push
  let mixed = {d: gen, items: chars} shuffle
  let text = {parts: mixed.items, sep: ""} joinStr
  return {d: mixed.d, text: text} Drawn

fn numberArg({a: Args, name: str, otherwise: int}) -> int:
  let v = {a: a, name: name} numberOf
  if v.ok:
    return {value: v.value} int
  return otherwise

fn main() -> int [io, io: sys, io: console]:
  let argv = commandLine
  let parsed = {c: command, argv: argv} tryParse
  if not parsed.ok:
    let usage = {c: command} usageOf
    {text: usage} printLine
    return 2
  let a = parsed.value
  let length = {a: a, name: "length", otherwise: 16} numberArg
  let howMany = {a: a, name: "count", otherwise: 1} numberArg
  let symbols = not {a: a, name: "no-symbols"} hasFlag
  let needed = {symbols: symbols} classes
  if length < needed.len:
    let least = {value: needed.len} toStr
    {text: "passgen: --length must be at least " + least} printLine
    return 2
  var gen = newDiceFromOs
  let seed = {a: a, name: "seed"} numberOf
  if seed.ok:
    let s = {value: seed.value} u64
    gen = {seed: s} newDice
  for i in 0 .. howMany - 1:
    let p = {d: gen, length: length, symbols: symbols} password
    gen = p.d
    {text: p.text} printLine
  return 0
