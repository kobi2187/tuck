# cli-hangman — guess the word one letter at a time.
#
#   hangman [--seed N]
#
# Reads one guess per line from stdin. `--seed` picks the word reproducibly
# (for a test, or to replay a game); without it the OS seeds the pick.
import console
import random
import str
import sys
import cli
import text

fn words() -> Seq[str]:
  return ["tuck", "compiler", "actor", "effect", "lexer", "coroutine", "reactor"]

fn command() -> Command:
  let seedArg = {name: "seed", shortName: "s", kind: ANumber, help: "pick the word reproducibly", required: false} spec
  let noSubs: Seq[Command] = []
  let args: Seq[ArgSpec] = [seedArg]
  return {name: "hangman", help: "guess the word", args: args, subcommands: noSubs} Command

# The word, from the seed when there is one.
fn secretWord({a: Args}) -> str [io: sys]:
  let all = words
  let seed = {a: a, name: "seed"} numberOf
  var dice = newDiceFromOs
  if seed.ok:
    let s = {value: seed.value} u64
    dice = {seed: s} newDice
  let r = {d: dice, low: 0, high: all.len - 1} rollRange
  if not r.ok:
    return all[0]
  return all[r.value.value]

fn maskWord({word: str, guessed: str}) -> str:
  var shown = ""
  for i in 0 .. {t: word} byteCount - 1:
    let c = {s: word, index: i} charAt
    if {s: guessed, ch: c} containsChar:
      shown = shown + c
    else:
      shown = shown + "_"
  return shown

fn main() -> int [io, io: sys, io: console]:
  let argv = commandLine
  let parsed = {c: command, argv: argv} tryParse
  if not parsed.ok:
    let usage = {c: command} usageOf
    {text: usage} printLine
    return 2
  let secret = {a: parsed.value} secretWord
  var guessed = ""
  var lives = 6
  for true:
    let masked = {word: secret, guessed: guessed} maskWord
    let left = {value: lives} toStr
    {text: "Word: " + masked + "   Lives: " + left} printLine
    if masked == secret:
      {text: "You win!"} printLine
      return 0
    if lives == 0:
      {text: "You lose. The word was: " + secret} printLine
      return 1
    let input = readLine
    if not input.ok:
      {text: "goodbye"} printLine
      return 3
    let line = {t: input.value.line} trim
    if {t: line} byteCount > 0:
      let g = {s: line, index: 0} charAt
      if {s: guessed, ch: g} containsChar:
        {text: "Already guessed " + g} printLine
      elif {s: secret, ch: g} containsChar:
        guessed = guessed + g
      else:
        guessed = guessed + g
        lives = lives - 1
  return 0
