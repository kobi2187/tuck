# core.contracts.collection — container protocols. Declarations only.

group Countable:
  fn count({self: Self}) -> int

group Emptyable:
  fn isEmpty({self: Self}) -> bool

group Clearable:
  fn clear({self: Self}) -> Self

group Indexable[E]:
  fn at({self: Self, index: int}) -> E

group Sliceable[E]:
  fn slice({self: Self, start: int, upto: int}) -> Self

group Appendable[E]:
  fn push({self: Self, item: E}) -> Self

group Removable[E]:
  fn pop({self: Self}) -> E?

group Keyed[K, V]:
  fn get({self: Self, key: K}) -> V?
  fn put({self: Self, key: K, value: V}) -> Self
  fn hasKey({self: Self, key: K}) -> bool

group SetLike[E]:
  fn contains({self: Self, item: E}) -> bool
  fn insert({self: Self, item: E}) -> Self
  fn remove({self: Self, item: E}) -> Self

group Iterator[E]:
  fn next({self: Self}) -> E?

group Buildable[E]:
  fn fromSeq({items: Seq[E]}) -> Self
