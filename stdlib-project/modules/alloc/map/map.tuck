# alloc.map — a key/value table, hashed.
#
# Tuck has no map at all: `Seq[T]` and `Array[N, T]` are the whole collection
# surface, which is why this is the highest-value module in the alloc tier —
# six modules downstream want one.
#
# REPRESENTATION: the entries live DENSE, in insertion order, in a Seq; beside
# them an open-addressing index (`slots`, linear probing) maps hash(key) to a
# position in `entries`, -1 for an empty slot. `get`, `set` and `has` are O(1)
# on average, the index is doubled when it is half full, and `keys`, `values`
# and `pairs` come out in insertion order for free. `remove` rebuilds, O(n):
# deletion from a probe sequence needs tombstones, and that waits on a
# measurement that wants it.
#
# A key is hashed by core.hash's `hashKey`: a str by its bytes, an integer,
# bool or enum by value, anything else by its text. Equality is `==`.
#
# Value semantics all the way: every mutating verb RETURNS the new table, the
# same convention std/seq's `push` follows, because a Seq can reallocate and
# there is no shared backing store to write through.
import hash
import seq

type Entry[K, V]:
  key: K
  value: V

type Table[K, V]:
  entries: Seq[Entry[K, V]]
  slots: Seq[int]

# There is no `newTable` fn, and that is the point: a construction under a
# stated type IS the constructor. `var rooms: Table[str, int] = {entries: [],
# slots: []} Table` binds K and V from the annotation, so a nullary generic fn
# — which nothing could ever infer K and V for — is not needed.

const FirstSlots = 8

# Where `key` lives in the index, or the empty slot where it would go. The
# index is never full (it is doubled at half), so the probe always ends.
# Requires a non-empty index.
fn slotOf[K, V]({entries: Seq[Entry[K, V]], slots: Seq[int], key: K}) -> int:
  let n = slots.len
  let h = {key: key} hashKey
  var i = (h % (n ~u64)) ~int
  for slots[i] >= 0 and entries[slots[i]].key != key:
    i = (i + 1) % n
  return i

# The position of `key` in `entries`, or -1.
fn indexOf[K, V]({t: Table[K, V], key: K}) -> int:
  if t.slots.len == 0:
    return 0 - 1
  let s = {entries: t.entries, slots: t.slots, key: key} slotOf
  return t.slots[s]

fn emptySlots({n: int}) -> Seq[int]:
  var out: Seq[int] = []
  for i in 0 ..< n:
    out = {items: out, value: 0 - 1} push
  return out

# An index of `n` slots over `entries`. Returns the index alone, so the
# entries are only read, never copied into a result.
fn indexed[K, V]({entries: Seq[Entry[K, V]], n: int}) -> Seq[int]:
  var slots = {n: n} emptySlots
  for i in 0 ..< entries.len:
    let s = {entries: entries, slots: slots, key: entries[i].key} slotOf
    slots[s] = i
  return slots

fn has[K, V]({t: Table[K, V], key: K}) -> bool:
  return {t: t, key: key} indexOf >= 0

fn count[K, V]({t: Table[K, V]}) -> int:
  return t.entries.len

fn get[K, V]({t: Table[K, V], key: K}) -> V?:
  let at = {t: t, key: key} indexOf
  if at < 0:
    return
  return t.entries[at].value

# Replaces in place when the key is present, appends when it is not — so a
# table never holds two entries for one key. Each part of `t` is taken once, so
# a caller's last use of the table moves it through instead of copying it.
fn set[K, V]({t: Table[K, V], key: K, value: V}) -> Table[K, V]:
  let at = {t: t, key: key} indexOf
  var es = t.entries
  var slots = t.slots
  let fresh = {key: key, value: value} Entry
  if at >= 0:
    es[at] = fresh
    return {entries: es, slots: slots} Table
  if (es.len + 1) * 2 > slots.len:
    let n = if slots.len == 0: FirstSlots else: slots.len * 2
    slots = {entries: es, n: n} indexed
  let s = {entries: es, slots: slots, key: key} slotOf
  slots[s] = es.len
  es = {items: es, value: fresh} push
  return {entries: es, slots: slots} Table

# Rust's `entry(k).or_insert(v)` in one verb: the existing value wins.
fn getOrSet[K, V]({t: Table[K, V], key: K, value: V}) -> Table[K, V]:
  if {t: t, key: key} has:
    return t
  return {t: t, key: key, value: value} set

# Rebuilt without the key rather than shuffled in place: order is the order of
# insertion, and a rebuild is the one form that keeps it.
fn remove[K, V]({t: Table[K, V], key: K}) -> Table[K, V]:
  var es: Seq[Entry[K, V]] = []
  for i in 0 ..< t.entries.len:
    let e = t.entries[i]
    if e.key != key:
      es = {items: es, value: e} push
  let slots = {entries: es, n: t.slots.len} indexed
  return {entries: es, slots: slots} Table

fn clear[K, V]({t: Table[K, V]}) -> Table[K, V]:
  let empty: Seq[Entry[K, V]] = []
  let unindexed: Seq[int] = []
  return {entries: empty, slots: unindexed} Table

fn keys[K, V]({t: Table[K, V]}) -> Seq[K]:
  var acc: Seq[K] = []
  for i in 0 .. t.entries.len - 1:
    acc = {items: acc, value: t.entries[i].key} push
  return acc

fn values[K, V]({t: Table[K, V]}) -> Seq[V]:
  var acc: Seq[V] = []
  for i in 0 .. t.entries.len - 1:
    acc = {items: acc, value: t.entries[i].value} push
  return acc

fn pairs[K, V]({t: Table[K, V]}) -> Seq[Entry[K, V]]:
  return t.entries

# Enough keys to force several doublings of the index, a replace of each, and
# a removal that must leave every other key findable.
fn checkMany() -> int:
  var t: Table[int, int] = {entries: [], slots: []} Table
  for i in 0 ..< 1000:
    t = {t: t, key: i * 7, value: i} set
  if {t: t} count != 1000:
    return 20
  for i in 0 ..< 1000:
    let g = {t: t, key: i * 7} get
    if not g.ok:
      return 21
    if g.value != i:
      return 22
  if {t: t, key: 3} has:
    return 23
  for i in 0 ..< 1000:
    t = {t: t, key: i * 7, value: i + 1} set
  if {t: t} count != 1000:
    return 24
  t = {t: t, key: 14} remove
  if {t: t} count != 999:
    return 25
  if {t: t, key: 14} has:
    return 26
  let g = {t: t, key: 700} get
  if not g.ok:
    return 27
  if g.value != 101:
    return 28
  return 0

fn main() -> int:
  var rooms: Table[str, int] = {entries: [], slots: []} Table
  rooms = {t: rooms, key: "lobby", value: 1} set
  rooms = {t: rooms, key: "attic", value: 2} set
  if {t: rooms} count != 2:
    return 1
  let lobby = {t: rooms, key: "lobby"} get
  if not lobby.ok:
    return 2
  if lobby.value != 1:
    return 3
  # An absent key is absence, not a zero.
  let missing = {t: rooms, key: "cellar"} get
  if missing.ok:
    return 4
  # set REPLACES; it never grows the table for a key already in it.
  rooms = {t: rooms, key: "lobby", value: 9} set
  if {t: rooms} count != 2:
    return 5
  let again = {t: rooms, key: "lobby"} get
  if not again.ok:
    return 6
  if again.value != 9:
    return 14
  # getOrSet leaves an existing value alone.
  rooms = {t: rooms, key: "lobby", value: 99} getOrSet
  let kept = {t: rooms, key: "lobby"} get
  if not kept.ok:
    return 7
  if kept.value != 9:
    return 15
  if not {t: rooms, key: "attic"} has:
    return 8
  rooms = {t: rooms, key: "attic"} remove
  if {t: rooms, key: "attic"} has:
    return 9
  if {t: rooms} count != 1:
    return 10
  let ks = {t: rooms} keys
  if ks.len != 1:
    return 11
  let vs = {t: rooms} values
  if vs.len != 1:
    return 12
  rooms = {t: rooms} clear
  if {t: rooms} count != 0:
    return 13
  return {} checkMany
