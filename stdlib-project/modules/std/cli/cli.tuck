# std.cli — a declarative command tree, an argument parser over it, usage text,
# tables and ANSI styling.
#
# A Command is plain data (`subcommands: Seq[Command]` recurses through Seq),
# so the parser and `usageOf` are ordinary recursive functions over it, with no
# macro. Parsing returns `?`: a bad command line is an absent answer.
#
# Prompts (`ask`, `confirm`, `choose`, `askNumber`, `askSecret`) and progress
# (`progressBar`, `showProgress`, `spinnerFrame`) are here too, on std/console
# (`readLine`, `print`). Reading an ANSWER is pure and checked directly
# (`parseYesNo`, `parseChoice`, `parseIntIn`); the interactive functions loop
# over `readLine` and are checked by running this program as a child process
# and feeding it input (sys.process), so they run under no terminal at all. At
# the end of input a prompt answers its fallback rather than looping forever.
#
# Not here: `isTerminal` (needs a native tty query).
import seq
import str
import text
import convert
import fmt
import sys
import console
import env
import process

type ArgKind:
  | AFlag
  | AText
  | ANumber

type ArgSpec:
  name: str
  shortName: str
  kind: ArgKind
  help: str
  required: bool

type Command:
  name: str
  help: str
  args: Seq[ArgSpec]
  subcommands: Seq[Command]

type Entry:
  key: str
  value: str

# `subcommand` is the name chosen, "" when none was.
type Args:
  named: Seq[Entry]
  positional: Seq[str]
  subcommand: str

type Colour:
  | Plain
  | Red
  | Green
  | Yellow
  | Blue

# --- lookup -------------------------------------------------------------------
fn specNamed({c: Command, name: str}) -> ArgSpec?:
  for i in 0 .. c.args.len - 1:
    if c.args[i].name == name:
      return c.args[i]
  return none

fn specShort({c: Command, letter: str}) -> ArgSpec?:
  for i in 0 .. c.args.len - 1:
    if c.args[i].shortName == letter:
      return c.args[i]
  return none

fn subcommandNamed({c: Command, name: str}) -> Command?:
  for i in 0 .. c.subcommands.len - 1:
    if c.subcommands[i].name == name:
      return c.subcommands[i]
  return none

fn textOf({a: Args, name: str}) -> str?:
  for i in 0 .. a.named.len - 1:
    if a.named[i].key == name:
      return a.named[i].value
  return none

fn numberOf({a: Args, name: str}) -> i64?:
  let t = {a: a, name: name} textOf
  if not t.ok:
    return none
  return {t: t.value} parseInt

fn hasFlag({a: Args, name: str}) -> bool:
  let t = {a: a, name: name} textOf
  return t.ok

# --- parsing ------------------------------------------------------------------
fn isNumber({t: str}) -> bool:
  let n = {t: t} parseInt
  return n.ok

# Does `spec` accept `value`? A flag takes none; a number must parse.
fn accepts({spec: ArgSpec, value: str}) -> bool:
  match spec.kind:
    AFlag: return false
    AText: return true
    ANumber: return {t: value} isNumber

fn isFlag({spec: ArgSpec}) -> bool:
  match spec.kind:
    AFlag: return true
    AText: return false
    ANumber: return false

# Every required argument of `c` present in `a`.
fn requiredPresent({c: Command, a: Args}) -> bool:
  for i in 0 .. c.args.len - 1:
    if c.args[i].required:
      if not {a: a, name: c.args[i].name} hasFlag:
        return false
  return true

fn withEntry({a: Args, key: str, value: str}) -> Args:
  let e = {key: key, value: value} Entry
  let grown = {items: a.named, value: e} push
  return {named: grown, positional: a.positional, subcommand: a.subcommand} Args

fn withPositional({a: Args, word: str}) -> Args:
  let grown = {items: a.positional, value: word} push
  return {named: a.named, positional: grown, subcommand: a.subcommand} Args

# Parse `argv` (the program name already removed) against `c`. `--name value`,
# `--name=value`, `-s value`, bare words as positionals; a first bare word that
# names a subcommand hands the rest of the line to that subcommand.
# The program's own arguments, without the program name: what `tryParse` takes.
fn commandLine() -> Seq[str] [io: sys]:
  var out: Seq[str] = []
  let n = argCount
  for i in 1 .. n.total:
    let a = {index: i} argAt
    out = {items: out, value: a.arg} push
  return out

fn tryParse({c: Command, argv: Seq[str]}) -> Args?:
  let empty: Seq[Entry] = []
  let words: Seq[str] = []
  var a = {named: empty, positional: words, subcommand: ""} Args
  var i = 0
  for i < argv.len:
    let arg = argv[i]
    i = i + 1
    if {t: arg, prefix: "--"} startsWith:
      let argLen = {t: arg} byteCount
      let body = {t: arg, start: 2, stop: argLen} slice
      if not body.ok:
        return none
      var name = body.value
      var attached = ""
      var hasAttached = false
      let eq = {t: body.value, what: "="} text::find
      if eq.ok:
        let n = {t: body.value, start: 0, stop: eq.value} slice
        let bodyLen = {t: body.value} byteCount
        let v = {t: body.value, start: eq.value + 1, stop: bodyLen} slice
        if not n.ok:
          return none
        if not v.ok:
          return none
        name = n.value
        attached = v.value
        hasAttached = true
      let spec = {c: c, name: name} specNamed
      if not spec.ok:
        return none
      if {spec: spec.value} isFlag:
        a = {a: a, key: name, value: "true"} withEntry
      else:
        var value = attached
        if not hasAttached:
          if i >= argv.len:
            return none
          value = argv[i]
          i = i + 1
        if not {spec: spec.value, value: value} accepts:
          return none
        a = {a: a, key: name, value: value} withEntry
    elif {t: arg, prefix: "-"} startsWith and {t: arg} byteCount == 2:
      let letter = {s: arg, index: 1} charAt
      let spec = {c: c, letter: letter} specShort
      if not spec.ok:
        return none
      if {spec: spec.value} isFlag:
        a = {a: a, key: spec.value.name, value: "true"} withEntry
      else:
        if i >= argv.len:
          return none
        let value = argv[i]
        i = i + 1
        if not {spec: spec.value, value: value} accepts:
          return none
        a = {a: a, key: spec.value.name, value: value} withEntry
    else:
      let sub = {c: c, name: arg} subcommandNamed
      if sub.ok:
        if a.positional.len == 0:
          let rest = {items: argv, start: i} tailFrom
          let inner = {c: sub.value, argv: rest} tryParse
          if not inner.ok:
            return none
          return {a: a, inner: inner.value, name: arg} merged
      a = {a: a, word: arg} withPositional
  if not {c: c, a: a} requiredPresent:
    return none
  return a

fn tailFrom({items: Seq[str], start: int}) -> Seq[str]:
  var out: Seq[str] = []
  for i in start .. items.len - 1:
    out = {items: out, value: items[i]} push
  return out

# The outer line's own entries first, then the subcommand's.
fn merged({a: Args, inner: Args, name: str}) -> Args:
  var vals = a.named
  for i in 0 .. inner.named.len - 1:
    vals = {items: vals, value: inner.named[i]} push
  var pos = a.positional
  for i in 0 .. inner.positional.len - 1:
    pos = {items: pos, value: inner.positional[i]} push
  return {named: vals, positional: pos, subcommand: name} Args

# --- usage ----------------------------------------------------------------------
fn flagText({spec: ArgSpec}) -> str:
  var s = "--" + spec.name
  if {t: spec.shortName} byteCount > 0:
    s = s + ", -" + spec.shortName
  return s

fn usageOf({c: Command}) -> str:
  var lines: Seq[str] = []
  lines = {items: lines, value: c.name + " - " + c.help} push
  for i in 0 .. c.args.len - 1:
    let spec = c.args[i]
    let flag = {spec: spec} flagText
    let left = {body: flag, width: 18, alignRight: false} pad
    var line = "  " + left + spec.help
    if spec.required:
      line = line + " (required)"
    lines = {items: lines, value: line} push
  for i in 0 .. c.subcommands.len - 1:
    let sub = c.subcommands[i]
    let left = {body: sub.name, width: 18, alignRight: false} pad
    lines = {items: lines, value: "  " + left + sub.help} push
  return {parts: lines, sep: "\n"} joinStr

# --- tables and colour ------------------------------------------------------------
fn widthOf({column: int, headers: Seq[str], rows: Seq[Seq[str]]}) -> int:
  var w = {t: headers[column]} byteCount
  for r in 0 .. rows.len - 1:
    let n = {t: rows[r][column]} byteCount
    if n > w:
      w = n
  return w

fn dashes({count: int}) -> str:
  var out = ""
  for i in 0 .. count - 1:
    out = out + "-"
  return out

# The last cell is not padded: a line never ends in spaces.
fn renderRow({cells: Seq[str], widths: Seq[int]}) -> str:
  var parts: Seq[str] = []
  for i in 0 .. cells.len - 1:
    var cell = cells[i]
    if i < cells.len - 1:
      cell = {body: cells[i], width: widths[i], alignRight: false} pad
    parts = {items: parts, value: cell} push
  return {parts: parts, sep: " | "} joinStr

fn renderTable({headers: Seq[str], rows: Seq[Seq[str]]}) -> str:
  var widths: Seq[int] = []
  for c in 0 .. headers.len - 1:
    let w = {column: c, headers: headers, rows: rows} widthOf
    widths = {items: widths, value: w} push
  var lines: Seq[str] = []
  let head = {cells: headers, widths: widths} renderRow
  lines = {items: lines, value: head} push
  var rule: Seq[str] = []
  for c in 0 .. widths.len - 1:
    let run = {count: widths[c]} dashes
    rule = {items: rule, value: run} push
  let ruleLine = {parts: rule, sep: " | "} joinStr
  lines = {items: lines, value: ruleLine} push
  for r in 0 .. rows.len - 1:
    let line = {cells: rows[r], widths: widths} renderRow
    lines = {items: lines, value: line} push
  return {parts: lines, sep: "\n"} joinStr

fn escapeByte() -> str:
  var b: Seq[u8] = []
  b = {items: b, value: 27} push
  return {bytes: b} fromBytes

fn colourCode({colour: Colour}) -> str:
  match colour:
    Plain: return ""
    Red: return "31"
    Green: return "32"
    Yellow: return "33"
    Blue: return "34"

# ANSI-styled text: "\e[1;31mtext\e[0m". Plain, not bold: the text unchanged.
fn styled({body: str, colour: Colour, bold: bool}) -> str:
  let code = {colour: colour} colourCode
  if code == "" and not bold:
    return body
  var attrs = code
  if bold:
    attrs = "1"
    if code != "":
      attrs = "1;" + code
  let esc = escapeByte
  return esc + "[" + attrs + "m" + body + esc + "[0m"


# --- reading an answer (pure) ----------------------------------------------------------
# yes/no: y, yes, n, no in any case; an empty answer means `fallback` when the
# prompt has one. Absent when it is anything else (the prompt asks again).
fn parseYesNo({t: str, fallback: bool, hasFallback: bool}) -> bool?:
  let trimmed = {t: t} trim
  let a = {t: trimmed} toLowerAscii
  if a == "y" or a == "yes":
    return true
  if a == "n" or a == "no":
    return false
  if a == "" and hasFallback:
    return fallback
  return none

# A 1-based number, or a name (any case, or a unique prefix) from `options`;
# the 0-based index. Absent when it names none or several.
fn parseChoice({t: str, options: Seq[str]}) -> int?:
  let trimmed = {t: t} trim
  let a = {t: trimmed} toLowerAscii
  if a == "":
    return none
  let n = {t: a} parseInt
  if n.ok:
    let k = n.value ^int
    if k >= 1 and k <= options.len:
      return k - 1
    return none
  var found = 0 - 1
  var hits = 0
  for i in 0 .. options.len - 1:
    let o = {t: options[i]} toLowerAscii
    if o == a:
      return i
    if {t: o, prefix: a} startsWith:
      found = i
      hits = hits + 1
  if hits == 1:
    return found
  return none

fn parseIntIn({t: str, lo: int, hi: int}) -> int?:
  let trimmed = {t: t} trim
  let n = {t: trimmed} parseInt
  if not n.ok:
    return none
  let k = n.value ^int
  if k < lo or k > hi:
    return none
  return k

# --- progress (pure) ----------------------------------------------------------------------
# "[=====>    ] 50%": `width` cells between the brackets.
fn progressBar({done: int, total: int, width: int}) -> str:
  var share = 0
  if total > 0:
    share = done * 100 /i total
  if share > 100:
    share = 100
  if share < 0:
    share = 0
  let filled = share * width /i 100
  var cells = ""
  for i in 0 .. width - 1:
    if i < filled:
      cells = cells + "="
    elif i == filled and share < 100:
      cells = cells + ">"
    else:
      cells = cells + " "
  let pct = {value: share} toStr
  return "[" + cells + "] " + pct + "%"

fn spinnerFrame({tick: int}) -> str:
  let frames: Seq[str] = ["|", "/", "-", "\\"]
  return frames[tick % 4]

# --- prompts (console) -------------------------------------------------------------------
# One line from the terminal, or absent at the end of input.
fn lineIn() -> str? [io: console]:
  let r = readConsoleLine
  if not r.ok:
    return none
  return r.value.line

fn ask({question: str, fallback: str}) -> str [io: console]:
  {text: question + " "} print
  let l = lineIn
  if not l.ok:
    return fallback
  let a = {t: l.value} trim
  if a == "":
    return fallback
  return a

fn confirm({question: str, fallback: bool}) -> bool [io: console]:
  var hint = "[y/N]"
  if fallback:
    hint = "[Y/n]"
  var again = true
  for again:
    {text: question + " " + hint + " "} print
    let l = lineIn
    if not l.ok:
      return fallback
    let v = {t: l.value, fallback: fallback, hasFallback: true} parseYesNo
    if v.ok:
      return v.value
  return fallback

# Lists the options, reads a number or a name, asks again on nonsense; the
# 0-based index. At the end of input, option 0.
fn choose({question: str, options: Seq[str]}) -> int [io: console]:
  {text: question} printLine
  for i in 0 .. options.len - 1:
    let n = {value: i + 1} toStr
    {text: "  " + n + ") " + options[i]} printLine
  var again = true
  for again:
    {text: "> "} print
    let l = lineIn
    if not l.ok:
      return 0
    let c = {t: l.value, options: options} parseChoice
    if c.ok:
      return c.value
  return 0

fn askNumber({question: str, lo: int, hi: int}) -> int [io: console]:
  var again = true
  for again:
    {text: question + " "} print
    let l = lineIn
    if not l.ok:
      return lo
    let v = {t: l.value, lo: lo, hi: hi} parseIntIn
    if v.ok:
      return v.value
  return lo

# Like `ask`, with the terminal's echo off while the answer is typed (`stty`;
# a no-op when stdin is not a terminal). The answer is not trimmed.
fn askSecret({question: str}) -> str [io: console, io: sys]:
  {text: question + " "} print
  let hidden = {line: "stty -echo 2>/dev/null"} runCommand
  let l = lineIn
  let shown = {line: "stty echo 2>/dev/null"} runCommand
  {text: ""} printLine
  if not l.ok:
    return ""
  return l.value

# Redraw one progress line in place (carriage return, no newline).
fn showProgress({done: int, total: int, width: int}) -> void [io: console]:
  let bar = {done: done, total: total, width: width} progressBar
  {text: "\r" + bar} print

# --- the module's own checks: the exit code names the first that fails -------------
fn spec({name: str, shortName: str, kind: ArgKind, help: str, required: bool}) -> ArgSpec:
  return {name: name, shortName: shortName, kind: kind, help: help, required: required} ArgSpec

fn demo() -> Command:
  var args: Seq[ArgSpec] = []
  let verbose = {name: "verbose", shortName: "v", kind: AFlag, help: "chatty", required: false} spec
  let name = {name: "name", shortName: "n", kind: AText, help: "who", required: true} spec
  let count = {name: "count", shortName: "c", kind: ANumber, help: "how many", required: false} spec
  args = {items: args, value: verbose} push
  args = {items: args, value: name} push
  args = {items: args, value: count} push
  var subs: Seq[Command] = []
  let noargs: Seq[ArgSpec] = []
  let nosubs: Seq[Command] = []
  let build = {name: "build", help: "make it", args: noargs, subcommands: nosubs} Command
  subs = {items: subs, value: build} push
  return {name: "app", help: "a demo", args: args, subcommands: subs} Command

fn checkParsing() -> int:
  let c = demo
  let argv: Seq[str] = ["--name", "bob", "-v", "--count=3", "extra"]
  let a = {c: c, argv: argv} tryParse
  if not a.ok:
    return 1
  let who = {a: a.value, name: "name"} textOf
  if not who.ok:
    return 2
  if who.value != "bob":
    return 2
  if not {a: a.value, name: "verbose"} hasFlag:
    return 3
  let n = {a: a.value, name: "count"} numberOf
  if not n.ok:
    return 4
  if n.value != 3:
    return 4
  if a.value.positional.len != 1 or a.value.positional[0] != "extra":
    return 5
  return checkRefusals

fn checkRefusals() -> int:
  let c = demo
  let noName: Seq[str] = ["-v"]
  let r1 = {c: c, argv: noName} tryParse
  if r1.ok:
    return 6
  let unknown: Seq[str] = ["--name", "x", "--bogus"]
  let r2 = {c: c, argv: unknown} tryParse
  if r2.ok:
    return 7
  let badNumber: Seq[str] = ["--name", "x", "--count", "many"]
  let r3 = {c: c, argv: badNumber} tryParse
  if r3.ok:
    return 8
  let dangling: Seq[str] = ["--name"]
  let r4 = {c: c, argv: dangling} tryParse
  if r4.ok:
    return 9
  return checkSubcommand

fn checkSubcommand() -> int:
  let c = demo
  let argv: Seq[str] = ["--name", "bob", "build"]
  let a = {c: c, argv: argv} tryParse
  if not a.ok:
    return 10
  if a.value.subcommand != "build":
    return 11
  return checkOutput

fn checkOutput() -> int:
  let c = demo
  let usage = {c: c} usageOf
  if not {t: usage, prefix: "app - a demo"} startsWith:
    return 12
  if not {t: usage, what: "--verbose, -v"} text::has:
    return 13
  if not {t: usage, what: "(required)"} text::has:
    return 14
  let headers: Seq[str] = ["id", "name"]
  let row1: Seq[str] = ["1", "alpha"]
  let row2: Seq[str] = ["22", "b"]
  var rows: Seq[Seq[str]] = []
  rows = {items: rows, value: row1} push
  rows = {items: rows, value: row2} push
  let table = {headers: headers, rows: rows} renderTable
  let want = "id | name\n-- | -----\n1  | alpha\n22 | b"
  if table != want:
    return 15
  let plain = {body: "x", colour: Plain, bold: false} styled
  if plain != "x":
    return 16
  let red = {body: "x", colour: Red, bold: true} styled
  if red.len != 12:
    return 17
  return 0

fn checkAnswers() -> int:
  let yes = {t: " YES ", fallback: false, hasFallback: false} parseYesNo
  if not yes.ok:
    return 30
  if not yes.value:
    return 30
  let n = {t: "n", fallback: true, hasFallback: false} parseYesNo
  if not n.ok:
    return 31
  if n.value:
    return 31
  let blank = {t: "", fallback: true, hasFallback: true} parseYesNo
  if not blank.ok:
    return 32
  if not blank.value:
    return 32
  let nofb = {t: "", fallback: true, hasFallback: false} parseYesNo
  if nofb.ok:
    return 33
  let junk = {t: "maybe", fallback: true, hasFallback: true} parseYesNo
  if junk.ok:
    return 34
  let opts: Seq[str] = ["red", "green", "grey"]
  let one = {t: "2", options: opts} parseChoice
  if not one.ok:
    return 35
  if one.value != 1:
    return 35
  let named = {t: "Green", options: opts} parseChoice
  if not named.ok:
    return 36
  if named.value != 1:
    return 36
  let prefix = {t: "re", options: opts} parseChoice
  if not prefix.ok:
    return 37
  if prefix.value != 0:
    return 37
  let ambiguous = {t: "gr", options: opts} parseChoice
  if ambiguous.ok:
    return 38
  let range = {t: "9", options: opts} parseChoice
  if range.ok:
    return 39
  let num = {t: " 42 ", lo: 1, hi: 100} parseIntIn
  if not num.ok:
    return 40
  if num.value != 42:
    return 40
  let out = {t: "101", lo: 1, hi: 100} parseIntIn
  if out.ok:
    return 41
  return 0

fn checkProgress() -> int:
  if {done: 0, total: 10, width: 10} progressBar != "[>         ] 0%":
    return 50
  if {done: 5, total: 10, width: 10} progressBar != "[=====>    ] 50%":
    return 51
  if {done: 10, total: 10, width: 10} progressBar != "[==========] 100%":
    return 52
  if {done: 99, total: 10, width: 10} progressBar != "[==========] 100%":
    return 53
  if {done: 1, total: 0, width: 4} progressBar != "[>   ] 0%":
    return 54
  if {tick: 5} spinnerFrame != "/":
    return 55
  return 0

# The interactive halves run in a CHILD: this program, started with a flag, fed
# its input over a pipe, with its answer read back. No terminal needed.
fn childRun({flag: str, feed: str}) -> str [io, io: console, io: sys]:
  let me = programPath
  let argv: Seq[str] = [me, flag]
  let r = {argv: argv} spawn
  if not r.ok:
    return "SPAWN FAILED"
  let c = r.value
  let wrote = {c: c, data: feed} writeIn
  {c: c} closeIn
  let out = {c: c, timeoutMs: 5000} readAllOut
  let st = {c: c} waitFor
  return out

fn checkInteractive() -> int [io, io: console, io: sys]:
  let a = {flag: "--demo-confirm", feed: "maybe\nyes\n"} childRun
  if a != "Proceed? [y/N] Proceed? [y/N] CONFIRMED\n":
    return 60
  let b = {flag: "--demo-confirm", feed: ""} childRun
  if b != "Proceed? [y/N] DECLINED\n":
    return 61
  let c = {flag: "--demo-choose", feed: "nope\nbl\n"} childRun
  if c != "Pick\n  1) red\n  2) blue\n> > CHOSE 1\n":
    return 62
  let d = {flag: "--demo-ask", feed: "  Ada \n"} childRun
  if d != "Name? HELLO Ada\n":
    return 63
  let e = {flag: "--demo-number", feed: "x\n0\n7\n"} childRun
  if e != "N? N? N? GOT 7\n":
    return 64
  return 0

# The child side of those checks.
fn demoChild({flag: str}) -> int [io: console]:
  if flag == "--demo-confirm":
    if {question: "Proceed?", fallback: false} confirm:
      {text: "CONFIRMED"} printLine
    else:
      {text: "DECLINED"} printLine
    return 0
  if flag == "--demo-choose":
    let opts: Seq[str] = ["red", "blue"]
    let k = {question: "Pick", options: opts} choose
    let n = {value: k} toStr
    {text: "CHOSE " + n} printLine
    return 0
  if flag == "--demo-ask":
    let who = {question: "Name?", fallback: "nobody"} ask
    {text: "HELLO " + who} printLine
    return 0
  if flag == "--demo-number":
    let v = {question: "N?", lo: 1, hi: 9} askNumber
    let n = {value: v} toStr
    {text: "GOT " + n} printLine
    return 0
  return 2

fn main() -> int [io, io: console, io: sys]:
  let mine = arguments
  if mine.len > 0:
    return {flag: mine[0]} demoChild
  let p = checkParsing
  if p != 0:
    return p
  let a = checkAnswers
  if a != 0:
    return a
  let g = checkProgress
  if g != 0:
    return g
  return checkInteractive
