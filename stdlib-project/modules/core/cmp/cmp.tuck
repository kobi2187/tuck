# core.cmp — ordering. The lowest building block: everything that sorts,
# searches or de-duplicates is written on top of this.
#
# Freestanding: no allocator, no OS, no externs. Pure Tuck.

type Order:
  | Before
  | Same
  | After

interface Sortable:
  fn compare({self: Self, other: Self}) -> Order

# Reverse an ordering — what a descending sort needs.
fn flipped({o: Order}) -> Order:
  match o:
    Before: return Order.After
    Same: return Order.Same
    After: return Order.Before

# Compose two orderings: the first decides unless it is a tie, in which case
# the second does. This is how a multi-key sort is written — `byLast
# breakTiesWith byFirst`.
fn breakTiesWith({o: Order, next: Order}) -> Order:
  match o:
    Same: return next
    Before: return Order.Before
    After: return Order.After

fn isBefore({o: Order}) -> bool:
  match o:
    Before: return true
    Same: return false
    After: return false

# The generic half. `smaller`/`larger`/`clamped` are the three every other
# module reaches for, and they are what made generic fns worth fixing on the
# Odin and D backends — until then only Nim could emit one, and nothing in the
# corpus was generic enough to notice.
fn smaller[T]({a: T, b: T}) -> T:
  if a < b:
    return a
  return b

fn larger[T]({a: T, b: T}) -> T:
  if a < b:
    return b
  return a

# Pinned into [low, high]. `low` wins a contradictory range rather than the
# call failing: a clamp with low > high is a caller bug, but silently
# returning `high` there would hide it behind a plausible-looking value.
fn clamped[T]({x: T, low: T, high: T}) -> T:
  if x < low:
    return low
  if high < x:
    return high
  return x

fn main() -> int:
  let f = {o: Order.Before} flipped
  let t = {o: Order.Same, next: Order.After} breakTiesWith
  if {o: f} isBefore:
    return 1
  if {o: t} isBefore:
    return 2
  let s = {a: 3, b: 9} smaller
  let l = {a: 3, b: 9} larger
  let c = {x: 42, low: 0, high: 10} clamped
  return s + l - c - 2
