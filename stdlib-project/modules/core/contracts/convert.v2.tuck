# core.contracts.convert — conversion and encoding protocols. Declarations only.

group Parsable:
  fn parse({text: str}) -> Option[Self]

group Encodable:
  fn toBytes({self: Self}) -> Seq[u8]

group Decodable:
  fn fromBytes({bytes: Seq[u8]}) -> Option[Self]

group Defaultable:
  fn default() -> Self
