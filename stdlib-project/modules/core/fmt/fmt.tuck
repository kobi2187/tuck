# core.fmt — padding and styling of text, and the two contracts a type signs
# to be rendered.
#
# `show` returns a str instead of writing into a caller's sink: a callee
# cannot write through a parameter (TK-TY15), and `toStr` already works this
# way. A type that satisfies neither interface cannot be rendered, so a secret
# cannot be logged by accident.
import seq
import str
import text

type Style:
  width: int
  precision: int
  alignRight: bool

interface Showable:
  fn show({self: Self}) -> str

interface Inspectable:
  fn inspect({self: Self}) -> str

fn spaces({count: int}) -> str:
  var parts: Seq[str] = []
  for i in 0 .. count - 1:
    parts = {items: parts, value: " "} push
  return {parts: parts, sep: ""} joinStr

# `body` made at least `width` bytes wide with spaces, on the left or right.
fn pad({body: str, width: int, alignRight: bool}) -> str:
  let missing = width - {t: body} byteCount
  if missing <= 0:
    return body
  let fill = {count: missing} spaces
  if alignRight:
    return fill + body
  return body + fill

# At most `precision` bytes (0 = all of it), then padded to `width`.
fn styled({body: str, style: Style}) -> str:
  var shown = body
  if style.precision > 0 and {t: body} byteCount > style.precision:
    let cut = {t: body, start: 0, stop: style.precision} slice
    if cut.ok:
      shown = cut.value
  return {body: shown, width: style.width, alignRight: style.alignRight} pad

fn render({v: Showable}) -> str:
  return v.show

fn renderDebug({v: Inspectable}) -> str:
  return v.inspect

object Tag:
  satisfies Showable
  satisfies Inspectable
  name: str

  fn show({self: Tag}) -> str:
    return self.name

  fn inspect({self: Tag}) -> str:
    return "Tag(" + self.name + ")"

# --- fixed-precision floats ---------------------------------------------------
# `fixed(x, 3)` is C's "%.3f": the same text on every backend. The value is
# scaled by 10^places in one IEEE multiply, split into whole and fraction
# exactly, and rounded half to even; so the digits are those of the double
# nearest `x * 10^places`, which can differ from a correctly rounded decimal
# expansion in the last place for a few values (a double does not hold 0.145
# exactly either). Places are clamped to 0 .. 15. A magnitude whose scaled value
# no longer fits an i64 falls back to `toStr`; nan and infinities are "nan",
# "inf" and "-inf". Negative values keep their sign even when they round to zero,
# as printf does.
fn tenPow({places: int}) -> f64:
  var scale = 1.0
  for i in 0 .. places - 1:
    scale = scale * 10.0
  return scale

fn zeroPadded({digits: str, width: int}) -> str:
  var out = digits
  for {t: out} byteCount < width:
    out = "0" + out
  return out

fn fixed({x: f64, places: int}) -> str:
  if x != x:
    return "nan"
  if x > 1.7976931348623157e308:
    return "inf"
  if x < 0.0 - 1.7976931348623157e308:
    return "-inf"
  var p = places
  if p < 0:
    p = 0
  if p > 15:
    p = 15
  let negative = x < 0.0
  var magnitude = x
  if negative:
    magnitude = 0.0 - x
  let scale = {places: p} tenPow
  let scaled = magnitude * scale
  if scaled >= 9.0e18:
    return {value: x} toStr
  let whole = scaled ~i64
  let wholeF = whole ~f64
  let frac = scaled - wholeF
  var units = whole
  let odd = whole % 2 == 1
  if frac > 0.5 or (frac == 0.5 and odd):
    units = whole + 1
  let all = {value: units} toStr
  let padded = {digits: all, width: p + 1} zeroPadded
  let n = {t: padded} byteCount
  var text = padded
  if p > 0:
    let head = {t: padded, start: 0, stop: n - p} slice
    let tail = {t: padded, start: n - p, stop: n} slice
    if head.ok:
      if tail.ok:
        text = head.value + "." + tail.value
  if negative:
    return "-" + text
  return text

fn checkPad() -> int:
  if {body: "ab", width: 5, alignRight: false} pad != "ab   ":
    return 1
  if {body: "ab", width: 5, alignRight: true} pad != "   ab":
    return 2
  if {body: "abcdef", width: 3, alignRight: true} pad != "abcdef":
    return 3
  if {body: "", width: 2, alignRight: false} pad != "  ":
    return 4
  return 0

fn checkStyled() -> int:
  let cut = {width: 6, precision: 3, alignRight: true} Style
  if {body: "abcdef", style: cut} styled != "   abc":
    return 5
  let all = {width: 0, precision: 0, alignRight: false} Style
  if {body: "abcdef", style: all} styled != "abcdef":
    return 6
  return 0

fn checkRender() -> int:
  let t = {name: "x"} Tag
  if {v: t} render != "x":
    return 7
  if {v: t} renderDebug != "Tag(x)":
    return 8
  return 0

fn checkFixed() -> int:
  if {x: 3.14159, places: 2} fixed != "3.14":
    return 10
  if {x: 2.5, places: 0} fixed != "2":
    return 11
  if {x: 3.5, places: 0} fixed != "4":
    return 12
  if {x: 0.5, places: 0} fixed != "0":
    return 13
  if {x: 0.0, places: 3} fixed != "0.000":
    return 14
  if {x: 1234.5678, places: 1} fixed != "1234.6":
    return 15
  if {x: 0.0 - 0.16907516382852447, places: 9} fixed != "-0.169075164":
    return 16
  if {x: 0.05, places: 3} fixed != "0.050":
    return 17
  if {x: 7.0, places: 0} fixed != "7":
    return 18
  if {x: 0.0 - 0.0004, places: 2} fixed != "-0.00":
    return 19
  if {x: 12.0, places: 20} fixed != "12.000000000000000":
    return 20
  if {x: 100000000000000000000.0, places: 2} fixed == "":
    return 21
  return 0

fn main() -> int:
  let p = checkPad
  if p != 0:
    return p
  let s = checkStyled
  if s != 0:
    return s
  let r = checkRender
  if r != 0:
    return r
  return checkFixed
