# core.iter — adapters and terminals over Seq[T], via fn references.
#
# Tuck has no closures: nothing captures the enclosing scope. So the Rust
# `.iter().filter(|x| ...)` shape doesn't port. What DOES port is `fnsig` +
# `:name` (a fn reference) — a named signature, and a plain top-level fn that
# satisfies it. See API.tuck.md for the fuller argument; the short version is
# that a `:fnRef` argument is exactly as cheap as Zig's `context, fn` pair and
# needs no closure machinery at all.
#
# `bake`-based adapter STORAGE (the doc's "reused query" section) is left out
# here: plain construction (`{items: xs, test: :isPositive} Query`) already
# gives a storable, nominal, zero-cost record, which is all that section
# actually needed. `bake` itself has a real bug (drops fields into a raw
# tuple instead of the named type) tracked separately — it doesn't block this
# module.
#
# Terminals return values; adapters return a new Seq. No hidden allocation:
# a chain like `{items: {items: xs, test: :p} filter, f: :g} map` is visibly
# two new sequences, matching the "no *hidden* allocation" tier ruling.

import seq

fnsig Mapper[T, U] = {x: T} -> U
fnsig Predicate[T] = {x: T} -> bool
# One element to several (flatMap); `U` stands bare so every backend can infer it.
fnsig Expander[T, U] = {x: T} -> Seq[U]
fnsig Combiner[T, A] = {acc: A, x: T} -> A
fnsig Action[T] = {x: T} -> void
# Does `a` go before `b`? A sort's whole idea of order.
fnsig Before[T] = {a: T, b: T} -> bool

# --- adapters: Seq[T] in, Seq[_] out ----------------------------------------

fn map[T, U]({items: Seq[T], f: Mapper[T, U]}) -> Seq[U]:
  var out: Seq[U] = []
  for i in 0 .. items.len - 1:
    let v = {x: items[i]} f
    out = {items: out, value: v} push
  return out

fn filter[T]({items: Seq[T], test: Predicate[T]}) -> Seq[T]:
  var out: Seq[T] = []
  for i in 0 .. items.len - 1:
    let v = items[i]
    if {x: v} test:
      out = {items: out, value: v} push
  return out

fn reject[T]({items: Seq[T], test: Predicate[T]}) -> Seq[T]:
  var out: Seq[T] = []
  for i in 0 .. items.len - 1:
    let v = items[i]
    if not ({x: v} test):
      out = {items: out, value: v} push
  return out

fn take[T]({items: Seq[T], n: int}) -> Seq[T]:
  var out: Seq[T] = []
  var i = 0
  for i < items.len and i < n:
    out = {items: out, value: items[i]} push
    i = i + 1
  return out

fn skip[T]({items: Seq[T], n: int}) -> Seq[T]:
  var out: Seq[T] = []
  var i = n
  for i < items.len:
    out = {items: out, value: items[i]} push
    i = i + 1
  return out

fn numbered[T]({items: Seq[T]}) -> Seq[{index: int, value: T}]:
  var out: Seq[{index: int, value: T}] = []
  for i in 0 .. items.len - 1:
    out = {items: out, value: {index: i, value: items[i]}} push
  return out

fn zip[T, U]({items: Seq[T], other: Seq[U]}) -> Seq[{left: T, right: U}]:
  var out: Seq[{left: T, right: U}] = []
  var n = items.len
  if other.len < n:
    n = other.len
  var i = 0
  for i < n:
    out = {items: out, value: {left: items[i], right: other[i]}} push
    i = i + 1
  return out

fn append[T]({items: Seq[T], other: Seq[T]}) -> Seq[T]:
  var out = items
  for i in 0 .. other.len - 1:
    out = {items: out, value: other[i]} push
  return out

fn prepend[T]({items: Seq[T], other: Seq[T]}) -> Seq[T]:
  var out = other
  for i in 0 .. items.len - 1:
    out = {items: out, value: items[i]} push
  return out

fn concat[T]({items: Seq[Seq[T]]}) -> Seq[T]:
  var out: Seq[T] = []
  for i in 0 .. items.len - 1:
    let inner = items[i]
    for j in 0 .. inner.len - 1:
      out = {items: out, value: inner[j]} push
  return out

fn reverse[T]({items: Seq[T]}) -> Seq[T]:
  var out: Seq[T] = []
  var i = items.len - 1
  for i >= 0:
    out = {items: out, value: items[i]} push
    i = i - 1
  return out

# --- terminals: Seq[T] in, a value out --------------------------------------

fn reduce[T, A]({items: Seq[T], start: A, combine: Combiner[T, A]}) -> A:
  var acc = start
  for i in 0 .. items.len - 1:
    acc = {acc: acc, x: items[i]} combine
  return acc

fn each[T]({items: Seq[T], f: Action[T]}) -> void:
  for i in 0 .. items.len - 1:
    {x: items[i]} f

fn find[T]({items: Seq[T], test: Predicate[T]}) -> T?:
  for i in 0 .. items.len - 1:
    let v = items[i]
    if {x: v} test:
      return v
  return

fn any[T]({items: Seq[T], test: Predicate[T]}) -> bool:
  for i in 0 .. items.len - 1:
    if {x: items[i]} test:
      return true
  return false

fn all[T]({items: Seq[T], test: Predicate[T]}) -> bool:
  for i in 0 .. items.len - 1:
    if not ({x: items[i]} test):
      return false
  return true

fn sum[T]({items: Seq[T]}) -> T?:
  # `?T`, not a bare `T` starting at 0: a real generic has no numeric zero to
  # seed from (there's no "any T with +" bound to ask for one), so an empty
  # Seq is genuinely absent rather than a silent 0. `reduce` is the verb for
  # "I have my own seed" — this is the one for "just add them up".
  if items.len == 0:
    return
  var acc = items[0]
  for i in 1 .. items.len - 1:
    acc = acc + items[i]
  return acc

# Two sorted Seqs into one, STABLE: on a tie the left element goes first.
fn mergeSorted[T]({left: Seq[T], right: Seq[T]}) -> Seq[T]:
  var out: Seq[T] = []
  var i = 0
  var j = 0
  for i < left.len and j < right.len:
    if right[j] < left[i]:
      out = {items: out, value: right[j]} push
      j = j + 1
    else:
      out = {items: out, value: left[i]} push
      i = i + 1
  for i < left.len:
    out = {items: out, value: left[i]} push
    i = i + 1
  for j < right.len:
    out = {items: out, value: right[j]} push
    j = j + 1
  return out

# Ascending, STABLE, O(n log n): a merge sort. Generic over `T` the same way
# core.cmp's smaller/larger are: an ordinary type parameter and the plain `<`.
fn sort[T]({items: Seq[T]}) -> Seq[T]:
  if items.len <= 1:
    return items
  let mid = items.len /i 2
  let left = {items: items, n: mid} take
  let right = {items: items, n: mid} skip
  let a = {items: left} sort
  let b = {items: right} sort
  return {left: a, right: b} mergeSorted

fn mergeBy[T]({left: Seq[T], right: Seq[T], before: Before[T]}) -> Seq[T]:
  var out: Seq[T] = []
  var i = 0
  var j = 0
  for i < left.len and j < right.len:
    if {a: right[j], b: left[i]} before:
      out = {items: out, value: right[j]} push
      j = j + 1
    else:
      out = {items: out, value: left[i]} push
      i = i + 1
  for i < left.len:
    out = {items: out, value: left[i]} push
    i = i + 1
  for j < right.len:
    out = {items: out, value: right[j]} push
    j = j + 1
  return out

# In the order `before` defines, STABLE: elements that neither goes before keep
# their input order, so sorting by one key and then another composes (the way
# Python's `sorted(xs, key=...)` does). A merge sort, O(n log n).
fn sortBy[T]({items: Seq[T], before: Before[T]}) -> Seq[T]:
  if items.len <= 1:
    return items
  let mid = items.len /i 2
  let left = {items: items, n: mid} take
  let right = {items: items, n: mid} skip
  let a = {items: left, before: before} sortBy
  let b = {items: right, before: before} sortBy
  return {left: a, right: b, before: before} mergeBy

# --- more adapters ----------------------------------------------------------

fn takeWhile[T]({items: Seq[T], test: Predicate[T]}) -> Seq[T]:
  var out: Seq[T] = []
  var i = 0
  for i < items.len and {x: items[i]} test:
    out = {items: out, value: items[i]} push
    i = i + 1
  return out

fn dropWhile[T]({items: Seq[T], test: Predicate[T]}) -> Seq[T]:
  var i = 0
  for i < items.len and {x: items[i]} test:
    i = i + 1
  return {items: items, n: i} skip

fn partition[T]({items: Seq[T], test: Predicate[T]}) -> {yes: Seq[T], no: Seq[T]}:
  var yes: Seq[T] = []
  var no: Seq[T] = []
  for i in 0 .. items.len - 1:
    let v = items[i]
    if {x: v} test:
      yes = {items: yes, value: v} push
    else:
      no = {items: no, value: v} push
  return {yes: yes, no: no}

# Groups of `size` (the last may be shorter); a size below 1 gives no groups.
fn chunk[T]({items: Seq[T], size: int}) -> Seq[Seq[T]]:
  var out: Seq[Seq[T]] = []
  if size < 1:
    return out
  var cur: Seq[T] = []
  for i in 0 .. items.len - 1:
    cur = {items: cur, value: items[i]} push
    if cur.len == size:
      out = {items: out, value: cur} push
      let blank: Seq[T] = []
      cur = blank
  if cur.len > 0:
    out = {items: out, value: cur} push
  return out

fn flatMap[T, U]({items: Seq[T], f: Expander[T, U]}) -> Seq[U]:
  var out: Seq[U] = []
  for i in 0 .. items.len - 1:
    let part = {x: items[i]} f
    for j in 0 .. part.len - 1:
      out = {items: out, value: part[j]} push
  return out

# Every running total: [a, b, c] with start s gives [s+a, s+a+b, ...] under the
# combiner. The seed itself is not in the result.
fn scan[T, A]({items: Seq[T], start: A, combine: Combiner[T, A]}) -> Seq[A]:
  var out: Seq[A] = []
  var acc = start
  for i in 0 .. items.len - 1:
    acc = {acc: acc, x: items[i]} combine
    out = {items: out, value: acc} push
  return out

fn intersperse[T]({items: Seq[T], sep: T}) -> Seq[T]:
  var out: Seq[T] = []
  for i in 0 .. items.len - 1:
    if i > 0:
      out = {items: out, value: sep} push
    out = {items: out, value: items[i]} push
  return out

# Keeps the first of each equal run of values anywhere in the Seq. Quadratic: a
# Seq of many distinct values wants a Set (alloc.set) instead.
fn unique[T]({items: Seq[T]}) -> Seq[T]:
  var out: Seq[T] = []
  for i in 0 .. items.len - 1:
    var seen = false
    for j in 0 .. out.len - 1:
      if out[j] == items[i]:
        seen = true
    if not seen:
      out = {items: out, value: items[i]} push
  return out

# --- more terminals ----------------------------------------------------------

fn first[T]({items: Seq[T]}) -> T?:
  if items.len == 0:
    return
  return items[0]

fn last[T]({items: Seq[T]}) -> T?:
  if items.len == 0:
    return
  return items[items.len - 1]

fn countWhere[T]({items: Seq[T], test: Predicate[T]}) -> int:
  var n = 0
  for i in 0 .. items.len - 1:
    if {x: items[i]} test:
      n = n + 1
  return n

fn product[T]({items: Seq[T]}) -> T?:
  if items.len == 0:
    return
  var acc = items[0]
  for i in 1 .. items.len - 1:
    acc = acc * items[i]
  return acc

fn smallest[T]({items: Seq[T]}) -> T?:
  if items.len == 0:
    return
  var best = items[0]
  for i in 1 .. items.len - 1:
    if items[i] < best:
      best = items[i]
  return best

fn largest[T]({items: Seq[T]}) -> T?:
  if items.len == 0:
    return
  var best = items[0]
  for i in 1 .. items.len - 1:
    if items[i] > best:
      best = items[i]
  return best

# The first element no other goes before, by the order `before` defines.
fn smallestBy[T]({items: Seq[T], before: Before[T]}) -> T?:
  if items.len == 0:
    return
  var best = items[0]
  for i in 1 .. items.len - 1:
    if {a: items[i], b: best} before:
      best = items[i]
  return best

# --- self-check --------------------------------------------------------------

fn isPositive({x: int}) -> bool:
  return x > 0

fn double({x: int}) -> int:
  return x * 2

fn addUp({acc: int, x: int}) -> int:
  return acc + x

fn recordEach({x: int}) -> void:
  return

fn checkFilterMap() -> int:
  let xs: Seq[int] = [0 - 3, 1, 4, 0 - 1, 5, 9]
  let live = {items: xs, test: :isPositive} filter
  if live.len != 4:
    return 1
  let doubled = {items: live, f: :double} map
  if doubled[0] != 2 or doubled[3] != 18:
    return 2
  let gone = {items: xs, test: :isPositive} reject
  if gone.len != 2:
    return 3
  return 0

fn checkSlices() -> int:
  let xs: Seq[int] = [0 - 3, 1, 4, 0 - 1, 5, 9]
  let first2 = {items: xs, n: 2} take
  if first2.len != 2 or first2[1] != 1:
    return 4
  let rest = {items: xs, n: 2} skip
  if rest.len != xs.len - 2 or rest[0] != 4:
    return 5
  let nums = {items: xs} numbered
  if nums[0].index != 0 or nums[2].value != 4:
    return 6
  return 0

fn checkJoins() -> int:
  let xs: Seq[int] = [0 - 3, 1, 4, 0 - 1, 5, 9]
  let first2 = {items: xs, n: 2} take
  let rest = {items: xs, n: 2} skip
  let ys: Seq[int] = [10, 20]
  let paired = {items: xs, other: ys} zip
  if paired.len != 2 or paired[1].left != 1 or paired[1].right != 20:
    return 7
  let joined = {items: first2, other: rest} append
  if joined.len != xs.len:
    return 8
  let front = {items: rest, other: first2} prepend
  if front.len != xs.len or front[0] != first2[0]:
    return 9
  let nested: Seq[Seq[int]] = [first2, rest]
  let flat = {items: nested} concat
  if flat.len != xs.len:
    return 10
  let backwards = {items: first2} reverse
  if backwards[0] != first2[1] or backwards[1] != first2[0]:
    return 11
  return 0

fn checkAdapters() -> int:
  let a = checkFilterMap
  if a != 0:
    return a
  let b = checkSlices
  if b != 0:
    return b
  return checkJoins

fn checkReduceFind() -> int:
  let xs: Seq[int] = [0 - 3, 1, 4, 0 - 1, 5, 9]
  let total = {items: xs, start: 0, combine: :addUp} reduce
  if total != 15:
    return 20
  {items: xs, f: :recordEach} each
  let hit = {items: xs, test: :isPositive} find
  if not hit.ok:
    return 21
  if hit.value != 1:
    return 21
  let noneHit = {items: [0 - 1, 0 - 2], test: :isPositive} find
  if noneHit.ok:
    return 22
  return 0

fn checkPredicates() -> int:
  let xs: Seq[int] = [0 - 3, 1, 4, 0 - 1, 5, 9]
  if not ({items: xs, test: :isPositive} any):
    return 23
  if {items: xs, test: :isPositive} all:
    return 24
  let miss = {items: xs, test: :isPositive} filter
  let total = {items: miss} sum
  if not total.ok:
    return 25
  if total.value != 19:
    return 25
  let noItems: Seq[int] = []
  let emptySum = {items: noItems} sum
  if emptySum.ok:
    return 26
  return 0

fn checkTerminals() -> int:
  let a = checkReduceFind
  if a != 0:
    return a
  return checkPredicates

fn checkOrder() -> int:
  let xs: Seq[int] = [5, 3, 0 - 1, 4, 4, 9, 0]
  let sorted = {items: xs} sort
  var i = 1
  for i < sorted.len:
    if sorted[i - 1] > sorted[i]:
      return 30
    i = i + 1
  if sorted[0] != 0 - 1 or sorted[sorted.len - 1] != 9:
    return 31
  return 0

type Pair:
  name: str
  score: int

fn higherFirst({a: Pair, b: Pair}) -> bool:
  return a.score > b.score

fn checkSortBy() -> int:
  let a = {name: "a", score: 2} Pair
  let b = {name: "b", score: 3} Pair
  let c = {name: "c", score: 2} Pair
  let d = {name: "d", score: 1} Pair
  let xs: Seq[Pair] = [a, b, c, d]
  let s = {items: xs, before: :higherFirst} sortBy
  # stable: a stays ahead of c, which scored the same
  if s[0].name != "b" or s[1].name != "a" or s[2].name != "c" or s[3].name != "d":
    return 90
  let empty: Seq[Pair] = []
  let e = {items: empty, before: :higherFirst} sortBy
  if e.len != 0:
    return 91
  return 0

fn isEven({x: int}) -> bool:
  return x % 2 == 0

fn pairUp({x: int}) -> Seq[int]:
  return [x, x]

fn checkMore() -> int:
  let xs: Seq[int] = [2, 4, 5, 6, 7, 8]
  let lead = {items: xs, test: :isEven} takeWhile
  if lead.len != 2 or lead[1] != 4:
    return 40
  let rest = {items: xs, test: :isEven} dropWhile
  if rest.len != 4 or rest[0] != 5:
    return 41
  let split = {items: xs, test: :isEven} partition
  if split.yes.len != 4 or split.no.len != 2 or split.no[1] != 7:
    return 42
  let groups = {items: xs, size: 4} chunk
  if groups.len != 2 or groups[0].len != 4 or groups[1].len != 2:
    return 43
  let zero: Seq[Seq[int]] = {items: xs, size: 0} chunk
  if zero.len != 0:
    return 44
  let flat = {items: lead, f: :pairUp} flatMap
  if flat.len != 4 or flat[2] != 4:
    return 45
  let running = {items: lead, start: 0, combine: :addUp} scan
  if running.len != 2 or running[1] != 6:
    return 46
  let spread = {items: lead, sep: 0} intersperse
  if spread.len != 3 or spread[1] != 0:
    return 47
  let dup: Seq[int] = [3, 1, 3, 2, 1]
  let uniq = {items: dup} unique
  if uniq.len != 3 or uniq[0] != 3 or uniq[2] != 2:
    return 48
  return 0

fn checkEnds() -> int:
  let xs: Seq[int] = [4, 9, 2, 7]
  let a = {items: xs} first
  if not a.ok:
    return 50
  if a.value != 4:
    return 50
  let b = {items: xs} last
  if not b.ok:
    return 51
  if b.value != 7:
    return 51
  let lo = {items: xs} smallest
  if not lo.ok:
    return 52
  if lo.value != 2:
    return 52
  let hi = {items: xs} largest
  if not hi.ok:
    return 53
  if hi.value != 9:
    return 53
  let p = {items: xs} product
  if not p.ok:
    return 54
  if p.value != 504:
    return 54
  if {items: xs, test: :isEven} countWhere != 2:
    return 55
  let empty: Seq[int] = []
  let nothing = {items: empty} last
  if nothing.ok:
    return 56
  return 0

fn checkBigSort() -> int:
  var xs: Seq[int] = []
  for i in 0 .. 999:
    xs = {items: xs, value: (i * 7919) % 1000} push
  let sorted = {items: xs} sort
  if sorted.len != 1000:
    return 60
  for i in 1 .. 999:
    if sorted[i - 1] > sorted[i]:
      return 61
  return 0


fn main() -> int:
  let sb = checkSortBy
  if sb != 0:
    return sb
  let a = checkAdapters
  if a != 0:
    return a
  let t = checkTerminals
  if t != 0:
    return t
  let o = checkOrder
  if o != 0:
    return o
  let m = checkMore
  if m != 0:
    return m
  let e = checkEnds
  if e != 0:
    return e
  return checkBigSort
