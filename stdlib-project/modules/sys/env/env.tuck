# sys.env — the process environment, and small things built on reading it.
#
# Everything here is native: std/sys carries the host calls (`getEnv`,
# `setEnv`, `unsetEnv`, `argCount`, `argAt`, `currentDir`, `changeDir`,
# `exePath`, `exit`), and this module is Tuck on top of them: a default, a PATH
# split into directories, `$NAME` / `${NAME}` expansion, the argument list and
# `--flag` / `--flag=value` lookup.
import sys
import seq
import str
import text

# The variable's value, or `fallback` when it is not set.
fn envOr({name: str, fallback: str}) -> str [io]:
  let v = {name: name} getEnv
  if v.ok:
    return v.value.value
  return fallback

fn hasEnv({name: str}) -> bool [io]:
  let v = {name: name} getEnv
  return v.ok

# The directories of a `:`-separated list (PATH, LD_LIBRARY_PATH), empty entries
# dropped.
fn splitPaths({list: str}) -> Seq[str]:
  let parts = {t: list, at: ":"} split
  var out: Seq[str] = []
  for i in 0 .. parts.len - 1:
    if parts[i] != "":
      out = {items: out, value: parts[i]} push
  return out

fn pathList({name: str}) -> Seq[str] [io]:
  let raw = {name: name, fallback: ""} envOr
  return {list: raw} splitPaths

fn isNameByte({c: int}) -> bool:
  if c >= 48 and c <= 57:
    return true
  if c >= 65 and c <= 90:
    return true
  if c >= 97 and c <= 122:
    return true
  return c == 95

# `$NAME` and `${NAME}` replaced by the variable's value (empty when unset); a
# `$` followed by anything else is left alone.
fn expandVars({t: str}) -> str [io]:
  var parts: Seq[str] = []
  var i = 0
  let n = {t: t} byteCount
  for i < n:
    let c = {s: t, index: i} charAt
    if c != "$" or i + 1 >= n:
      parts = {items: parts, value: c} push
      i = i + 1
      continue
    let next = {s: t, index: i + 1} charAt
    var start = i + 1
    var stop = start
    var braced = false
    if next == "{":
      braced = true
      start = i + 2
      stop = start
    for stop < n:
      let b = {t: t, index: stop} byteAt
      let code = {value: b} int
      if not {c: code} isNameByte:
        break
      stop = stop + 1
    var startsWithDigit = false
    if stop > start:
      let first = {t: t, index: start} byteAt
      startsWithDigit = first >= 48 and first <= 57
    if stop == start or startsWithDigit:
      parts = {items: parts, value: c} push
      i = i + 1
      continue
    let name = {t: t, start: start, stop: stop} slice
    if not name.ok:
      return t
    let value = {name: name.value, fallback: ""} envOr
    parts = {items: parts, value: value} push
    i = stop
    if braced and stop < n:
      i = stop + 1
  return {parts: parts, sep: ""} joinStr


# --- arguments ----------------------------------------------------------------------
# The program's arguments, not counting the program itself.
fn arguments() -> Seq[str] [io]:
  var out: Seq[str] = []
  let n = argCount
  for i in 1 .. n.total:
    let a = {index: i} argAt
    out = {items: out, value: a.arg} push
  return out

# Where the program lives; "" when the OS will not say.
fn programPath() -> str [io]:
  let p = exePath
  return p.path

# Is `--name` (or `--name=...`) among `args`?
fn hasFlagIn({args: Seq[str], name: str}) -> bool:
  let bare = "--" + name
  let withValue = "--" + name + "="
  for i in 0 .. args.len - 1:
    if args[i] == bare or {t: args[i], prefix: withValue} startsWith:
      return true
  return false

# The value of `--name=value` or `--name value`; absent when the flag is not
# there or ends the list with no value.
fn flagValueIn({args: Seq[str], name: str}) -> str?:
  let bare = "--" + name
  let withValue = "--" + name + "="
  for i in 0 .. args.len - 1:
    if {t: args[i], prefix: withValue} startsWith:
      let n = {t: args[i]} byteCount
      let k = {t: withValue} byteCount
      let v = {t: args[i], start: k, stop: n} slice
      if v.ok:
        return v.value
    if args[i] == bare and i + 1 < args.len:
      return args[i + 1]
  return none

# The arguments that are not flags (no leading `-`), in order.
fn positionalIn({args: Seq[str]}) -> Seq[str]:
  var out: Seq[str] = []
  for i in 0 .. args.len - 1:
    if not {t: args[i], prefix: "-"} startsWith:
      out = {items: out, value: args[i]} push
  return out

fn hasFlag({name: str}) -> bool [io]:
  let args = arguments
  return {args: args, name: name} hasFlagIn

fn flagValue({name: str}) -> str? [io]:
  let args = arguments
  return {args: args, name: name} flagValueIn

# --- changing the process --------------------------------------------------------------
fn setVar({name: str, value: str}) -> bool [io]:
  let r = {name: name, value: value} setEnv
  return r.code == 0

fn removeVar({name: str}) -> bool [io]:
  let r = {name: name} unsetEnv
  return r.code == 0

fn workingDir() -> str [io]:
  let d = currentDir
  return d.path

fn enterDir({path: str}) -> bool [io]:
  let r = {path: path} changeDir
  return r.code == 0

fn checkRead() -> int [io]:
  if {name: "TUCK_SYS_ENV_NOT_SET_X", fallback: "dflt"} envOr != "dflt":
    return 1
  if {name: "TUCK_SYS_ENV_NOT_SET_X"} hasEnv:
    return 2
  if not {name: "PATH"} hasEnv:
    return 3
  return 0

fn checkPaths() -> int [io]:
  let dirs = {list: "/a::/b:/c:"} splitPaths
  if dirs.len != 3 or dirs[0] != "/a" or dirs[2] != "/c":
    return 4
  let real = {name: "PATH"} pathList
  if real.len == 0:
    return 5
  let absent = {name: "TUCK_SYS_ENV_NOT_SET_X"} pathList
  if absent.len != 0:
    return 6
  return 0

fn checkExpand() -> int [io]:
  if {t: "a$TUCK_SYS_ENV_NOT_SET_Xb"} expandVars != "a":
    return 7
  if {t: "a${TUCK_SYS_ENV_NOT_SET_X}b"} expandVars != "ab":
    return 8
  if {t: "cost $5 and $"} expandVars != "cost $5 and $":
    return 9
  if {t: "no vars"} expandVars != "no vars":
    return 10
  let path = {t: "$PATH"} expandVars
  if path == "" or path == "$PATH":
    return 11
  return 0


fn checkArgs() -> int:
  let args: Seq[str] = ["build", "--out=bin", "--verbose", "--jobs", "4", "file.tuck", "-x"]
  if not {args: args, name: "verbose"} hasFlagIn:
    return 20
  if not {args: args, name: "out"} hasFlagIn:
    return 21
  if {args: args, name: "missing"} hasFlagIn:
    return 22
  let out = {args: args, name: "out"} flagValueIn
  if not out.ok:
    return 23
  if out.value != "bin":
    return 23
  let jobs = {args: args, name: "jobs"} flagValueIn
  if not jobs.ok:
    return 24
  if jobs.value != "4":
    return 24
  let tail: Seq[str] = ["--jobs"]
  let none0 = {args: tail, name: "jobs"} flagValueIn
  if none0.ok:
    return 25
  let pos = {args: args} positionalIn
  # (a flag's separate value is positional to this reader: it cannot know)
  if pos.len != 3:
    return 26
  if pos[0] != "build" or pos[1] != "4" or pos[2] != "file.tuck":
    return 27
  return 0

fn checkProcess() -> int [io]:
  # no arguments were passed to this test program
  let mine = arguments
  if mine.len != 0:
    return 30
  let me = programPath
  if {t: me} byteCount == 0:
    return 31
  return 0

fn checkChange() -> int [io]:
  if not {name: "TUCK_SYS_ENV_SET_Y", value: "hello"} setVar:
    return 40
  if {name: "TUCK_SYS_ENV_SET_Y", fallback: "dflt"} envOr != "hello":
    return 41
  if {t: "[$TUCK_SYS_ENV_SET_Y]"} expandVars != "[hello]":
    return 42
  if not {name: "TUCK_SYS_ENV_SET_Y"} removeVar:
    return 43
  if {name: "TUCK_SYS_ENV_SET_Y"} hasEnv:
    return 44
  let here = workingDir
  if {t: here} byteCount == 0:
    return 45
  if not {path: "/"} enterDir:
    return 46
  if workingDir != "/":
    return 47
  if {path: "/no/such/dir/anywhere"} enterDir:
    return 48
  if not {path: here} enterDir:
    return 49
  return 0

fn main() -> int [io]:
  let a = checkRead
  if a != 0:
    return a
  let b = checkPaths
  if b != 0:
    return b
  let c = checkExpand
  if c != 0:
    return c
  let d = checkArgs
  if d != 0:
    return d
  let e = checkProcess
  if e != 0:
    return e
  return checkChange
