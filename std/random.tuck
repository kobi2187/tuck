# std/random — non-cryptographic PRNG (PCG32). Implemented by tuck_rt.
# Deliberately shares no type or proc with std/crypto's CSPRNG.
#
# A NAMED record (`type Dice = {state: u64, inc: u64}`) cannot cross this
# boundary today: codegen emits it as a fresh `tuck_Dice object` inside the
# MODULE that declares it (random.nim), which imports tuck_rt — so tuck_rt
# can never see that type back to implement against it. Every existing
# extern module sidesteps this by using only ANONYMOUS records built from
# primitives; the PRNG state does the same here, spelled out in full on
# every signature instead of behind one type name.
extern:
  fn newDice({seed: u64}) -> {state: u64, inc: u64}
  fn newDiceFromOs() -> {state: u64, inc: u64} [io]
  fn rollRange({state: u64, inc: u64, low: i64, high: i64}) -> {state: u64, inc: u64, value: i64}
