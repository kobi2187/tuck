# std/console — terminal I/O. Implemented by tuck_rt.
#
# Named `console`, not `io`: `io` is the effect attribute `[io]`, a reserved
# word, so it cannot also be a module name. Reserving it is what makes
# `Box[error]` decidable — an attribute name is never an identifier.
type IoError:
  | EndOfInput
  | IoFailed

extern:
  fn print({text: str}) -> void [io: console]
  fn printLine({text: str}) -> void [io: console]
  # A line to stderr, which is unbuffered: diagnostics and logs, kept apart
  # from the output a pipe carries on.
  fn printError({text: str}) -> void [io: console]
  fn readLine() -> !{line: str} [io: console, error: IoError]
