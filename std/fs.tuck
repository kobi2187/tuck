# std/fs — file system. Implemented by tuck_rt over Nim's portable stdlib.
type FsError:
  | NotFound
  | AccessDenied
  | IoFailed
  | NotEmpty

extern:
  fn readFile({path: str}) -> !{content: str} [io: fs, error: FsError]
  fn writeFile({path: str, content: str}) -> !void [io: fs, error: FsError]
  fn appendFile({path: str, content: str}) -> !void [io: fs, error: FsError]
  fn fileExists({path: str}) -> bool [io: fs]
  fn removeFile({path: str}) -> !void [io: fs, error: FsError]
  # Idempotent: succeeds if the directory already exists. Creates any
  # missing parent directories (mkdir -p), same as writeFile's own
  # comment on wanting a real init path for any app that bootstraps a
  # store directory.
  fn makeDir({path: str}) -> !void [io: fs, error: FsError]
  # The names (not paths) directly inside `path`, sorted; empty when `path` is
  # missing or not a directory.
  fn listDir({path: str}) -> Seq[str] [io: fs]
  # What is at `path`, without following a final symbolic link: a folder, a
  # link, or (neither) a file; its size in bytes and when it last changed, in
  # milliseconds since the Unix epoch. Not offloaded, like fileExists: one stat.
  fn pathInfo({path: str}) -> !{isFolder: bool, isLink: bool, bytes: int, modifiedMs: int} [io: fs, error: FsError]
  # Rename or move within one filesystem; an existing file at `to` is replaced.
  fn renamePath({path: str, to: str}) -> !void [io: fs, error: FsError]
  # Remove an EMPTY folder: NotEmpty otherwise. A file is removeFile's.
  fn removeFolder({path: str}) -> !void [io: fs, error: FsError]
