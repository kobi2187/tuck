# std/str — text conversion. Implemented by tuck_rt.
#
# No char type exists in Tuck today, and str indexing has no syntax — a
# one-character result is spelled as a length-1 str, same as every other
# string here. `charAt`/`containsChar` are the minimal pair a masked-display
# app (hangman) needs; `.len` is used elsewhere but declared NOWHERE (a
# known bug, TODO.md §3 — it currently resolves only by Nim UFCS accident).
extern:
  fn toStr[T]({value: T}) -> str
  fn charAt({s: str, index: int}) -> str
  fn containsChar({s: str, ch: str}) -> bool
  fn splitLines({s: str}) -> Seq[str]
  # `ch` is a length-1 str, same convention as charAt's result. Indexing an
  # empty str is a bounds precondition violation, same as at/setAt.
  fn ord({ch: str}) -> int
  # Concatenating in a loop is O(n^2) — `acc = acc + part` copies the whole
  # string each time, and unlike a Seq append there is no in-place form for
  # the emitters to recognise (measured: 3.5x on Odin for a doubled input).
  # Every host stdlib joins in one pass, so this is a primitive rather than
  # something alloc.string could write for itself.
  fn joinStr({parts: Seq[str], sep: str}) -> str
