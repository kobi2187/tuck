# std/str — text conversion. Implemented by tuck_rt.
#
# No char type exists in Tuck today, and str indexing has no syntax — a
# one-character result is spelled as a length-1 str, same as every other
# string here. `charAt`/`containsChar` are the minimal pair a masked-display
# app (hangman) needs; `.len` is used elsewhere but declared NOWHERE (a
# known bug, TODO.md §3 — it currently resolves only by Nim UFCS accident).
extern:
  fn toStr[T]({value: T}) -> str
  fn charAt({s: str, index: int}) -> str
  fn containsChar({s: str, ch: str}) -> bool
  fn splitLines({s: str}) -> Seq[str]
  # `ch` is a length-1 str, same convention as charAt's result. Indexing an
  # empty str is a bounds precondition violation, same as at/setAt.
  fn ord({ch: str}) -> int
  # Concatenating in a loop is O(n^2) — `acc = acc + part` copies the whole
  # string each time, and unlike a Seq append there is no in-place form for
  # the emitters to recognise (measured: 3.5x on Odin for a doubled input).
  # Every host stdlib joins in one pass, so this is a primitive rather than
  # something alloc.string could write for itself.
  fn joinStr({parts: Seq[str], sep: str}) -> str
  # A `str` is BYTES. `charAt` hands back a one-byte str, so every byte-level
  # fold has had to spell `{ch: {s: t, index: i} charAt} ord` — two calls and
  # a temporary to read one byte (core.hash's FNV loop does exactly that).
  # These two say what is actually going on, and `byteCount` names what `.len`
  # has always meant for text rather than leaving "how long" ambiguous
  # between bytes and runes.
  fn byteAt({t: str, index: int}) -> u8
  fn byteCount({t: str}) -> int
  # The one text conversion that cannot be written in Tuck. Correctly rounded
  # decimal-to-binary is a real algorithm, not a fold — every host already
  # ships one, and a hand-rolled version would differ between backends, which
  # is the one thing the language will not allow. `parseInt` is NOT here: it
  # is an honest fold over digits, and core.convert writes it in Tuck on
  # core.num's overflow-checked arithmetic.
  fn parseFloat({t: str}) -> float?
  # The one direction Tuck cannot go by itself: bytes ARE readable
  # (`byteAt`), but there is no way to BUILD a str from arbitrary bytes —
  # `charAt` only ever hands back bytes that were already in a str. Encoding
  # a rune to UTF-8 is a fold Tuck can write; emitting the resulting bytes as
  # text is not.
  fn fromBytes({bytes: Seq[u8]}) -> str
