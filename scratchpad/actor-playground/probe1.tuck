# Probe: does a FULL mailbox drop, block, or corrupt? [queue: 4] with 10 sends.
# FRICTIONS.md #9 records that the spec never states the policy.
import scheduler

actor Small [queue: 4]:
  got: int = 0

  on ping({n: int}):
    got += n

fn done() -> bool:
  return Small.got >= 10

fn main() -> int:
  for i in 1 .. 10:
    Small send ping {n: 1}
  scheduler::waitUntil {pred: :done}
  return Small.got
