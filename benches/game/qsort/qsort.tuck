# qsort: in-place quicksort (Lomuto partition) of n pseudo-random ints.
# Written plainly and NOT tuned.
import console
import convert
import cli
import seq
import str

fn randoms({n: int, seed: int, modulus: int}) -> Seq[int]:
  var out: Seq[int] = []
  var s = seed
  for i in 0 ..< n:
    s = (s * 1103515245 + 12345) % 2147483648
    out = {items: out, value: s % modulus} push
  return out

type Split:
  a: Seq[int]
  p: int

fn partition({a: Seq[int], lo: int, hi: int}) -> Split:
  var out = a
  let pivot = out[hi]
  var i = lo
  for j in lo ..< hi:
    if out[j] < pivot:
      let t = out[i]
      out[i] = out[j]
      out[j] = t
      i = i + 1
  let t2 = out[i]
  out[i] = out[hi]
  out[hi] = t2
  return {a: out, p: i} Split

fn sorted({a: Seq[int], lo: int, hi: int}) -> Seq[int]:
  if lo >= hi:
    return a
  let s = {a: a, lo: lo, hi: hi} partition
  let left = {a: s.a, lo: lo, hi: s.p - 1} sorted
  return {a: left, lo: s.p + 1, hi: hi} sorted

fn checksum({a: Seq[int]}) -> int:
  var s = 0
  for i in 0 ..< a.len:
    s = (s + a[i] * (i % 7 + 1)) % 1000000007
  return s

fn problemSize({argv: Seq[str]}) -> int:
  if argv.len > 0:
    let n = {t: argv[0]} parseInt
    if n.ok:
      return n.value ^int
  return 1000

fn main() -> int [io: console, io: sys]:
  let argv = {} commandLine
  let n = {argv: argv} problemSize
  let xs = {n: n, seed: 7, modulus: 1000000} randoms
  let ys = {a: xs, lo: 0, hi: n - 1} sorted
  let r = {a: ys} checksum
  {text: r.toStr} printLine
  return 0
