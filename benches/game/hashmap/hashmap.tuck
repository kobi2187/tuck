# hashmap: insert n pseudo-random keys into a Table, then look every one up.
# Written plainly and NOT tuned.
import console
import convert
import cli
import seq
import str
import map

fn build({n: int}) -> Table[int, int]:
  var t: Table[int, int] = {entries: [], slots: []} Table
  var s = 1
  for i in 0 ..< n:
    s = (s * 1103515245 + 12345) % 2147483648
    t = {t: t, key: s % 1000003, value: i} set
  return t

fn lookups({t: Table[int, int], n: int}) -> int:
  var hits = 0
  var s = 1
  for i in 0 ..< n:
    s = (s * 1103515245 + 12345) % 2147483648
    let r = {t: t, key: s % 1000003} get
    if r.ok:
      hits = hits + r.value % 10
  return hits

fn problemSize({argv: Seq[str]}) -> int:
  if argv.len > 0:
    let n = {t: argv[0]} parseInt
    if n.ok:
      return n.value ^int
  return 1000

fn main() -> int [io: console, io: sys]:
  let argv = {} commandLine
  let n = {argv: argv} problemSize
  let t = {n: n} build
  let r = {t: t, n: n} lookups
  {text: r.toStr} printLine
  return 0
