# wordcount: count how often each of 1000 words occurs in a pseudo-random stream.
# Written plainly and NOT tuned.
import console
import convert
import cli
import seq
import str
import map

fn word({k: int}) -> str:
  return "w" + k.toStr

fn tally({n: int}) -> Table[str, int]:
  var t: Table[str, int] = {entries: [], slots: []} Table
  var s = 5
  for i in 0 ..< n:
    s = (s * 1103515245 + 12345) % 2147483648
    let w = {k: s % 1000} word
    let seen = {t: t, key: w} get
    let prior = if seen.ok: seen.value else: 0
    t = {t: t, key: w, value: prior + 1} set
  return t

fn checksum({t: Table[str, int], keys: int}) -> int:
  var s = 0
  for k in 0 ..< keys:
    let w = {k: k} word
    let seen = {t: t, key: w} get
    if seen.ok:
      s = (s * 31 + seen.value) % 1000000007
  return s

fn problemSize({argv: Seq[str]}) -> int:
  if argv.len > 0:
    let n = {t: argv[0]} parseInt
    if n.ok:
      return n.value ^int
  return 1000

fn main() -> int [io: console, io: sys]:
  let argv = {} commandLine
  let n = {argv: argv} problemSize
  let t = {n: n} tally
  let r = {t: t, keys: 1000} checksum
  {text: r.toStr} printLine
  return 0
