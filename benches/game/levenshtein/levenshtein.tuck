# levenshtein: the edit distance of two pseudo-random strings, two rolling rows.
# Written plainly and NOT tuned.
import console
import convert
import cli
import seq
import str

fn randoms({n: int, seed: int, modulus: int}) -> Seq[int]:
  var out: Seq[int] = []
  var s = seed
  for i in 0 ..< n:
    s = (s * 1103515245 + 12345) % 2147483648
    out = {items: out, value: s % modulus} push
  return out

fn distance({a: Seq[int], b: Seq[int]}) -> int:
  var prev: Seq[int] = []
  for j in 0 ..< b.len + 1:
    prev = {items: prev, value: j} push
  for i in 1 ..< a.len + 1:
    var cur: Seq[int] = [i]
    for j in 1 ..< b.len + 1:
      var best = prev[j - 1]
      if a[i - 1] != b[j - 1]:
        best = best + 1
      let up = prev[j] + 1
      if up < best:
        best = up
      let left = cur[j - 1] + 1
      if left < best:
        best = left
      cur = {items: cur, value: best} push
    prev = cur
  return prev[b.len]

fn problemSize({argv: Seq[str]}) -> int:
  if argv.len > 0:
    let n = {t: argv[0]} parseInt
    if n.ok:
      return n.value ^int
  return 500

fn main() -> int [io: console, io: sys]:
  let argv = {} commandLine
  let n = {argv: argv} problemSize
  let a = {n: n, seed: 1, modulus: 4} randoms
  let b = {n: n, seed: 2, modulus: 4} randoms
  let r = {a: a, b: b} distance
  {text: r.toStr} printLine
  return 0
