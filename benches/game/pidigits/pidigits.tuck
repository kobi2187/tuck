# pidigits (the Benchmarks Game): the first n digits of pi by Gibbons' unbounded
# spigot, ten to a line with the running count. The game's programs use GMP;
# the stdlib has no big integer, so this one is built on ./bignat, a Seq of
# base-10^9 limbs. Written plainly and NOT tuned.
import bignat
import console
import convert
import cli
import seq
import str

type Spigot:
  numer: Seq[int]
  denom: Seq[int]
  accum: Seq[int]
  k: int

fn start() -> Spigot:
  let one = {n: 1} natFromInt
  let zero = {n: 0} natFromInt
  return {numer: one, denom: one, accum: zero, k: 0} Spigot

# Fold the next term of the series in.
fn nextTerm({s: Spigot}) -> Spigot:
  let k = s.k + 1
  let y2 = k * 2 + 1
  let doubled = {a: s.numer, m: 2} natMulSmall
  let sum = {a: s.accum, b: doubled} natAdd
  let accum = {a: sum, m: y2} natMulSmall
  let numer = {a: s.numer, m: k} natMulSmall
  let denom = {a: s.denom, m: y2} natMulSmall
  return {numer: numer, denom: denom, accum: accum, k: k} Spigot

# floor((numer * nth + accum) / denom)
fn extract({s: Spigot, nth: int}) -> int:
  let scaled = {a: s.numer, m: nth} natMulSmall
  let total = {a: scaled, b: s.accum} natAdd
  return {a: total, b: s.denom} natQuotient

# Remove digit d from the front of the remaining expansion.
fn eliminate({s: Spigot, d: int}) -> Spigot:
  let taken = {a: s.denom, m: d} natMulSmall
  let rest = {a: s.accum, b: taken} natSub
  let accum = {a: rest, m: 10} natMulSmall
  let numer = {a: s.numer, m: 10} natMulSmall
  return {numer: numer, denom: s.denom, accum: accum, k: s.k} Spigot

fn lineOf({digits: str, count: int}) -> str:
  var pad = digits
  for pad.len < 10:
    pad = pad + " "
  return pad + "\t:" + count.toStr

fn digitsOf({n: int}) -> void [io: console]:
  var s = {} start
  var line = ""
  var shown = 0
  for shown < n:
    s = {s: s} nextTerm
    if {a: s.numer, b: s.accum} natCmp <= 0:
      let d = {s: s, nth: 3} extract
      let e = {s: s, nth: 4} extract
      if d == e:
        line = line + d.toStr
        shown = shown + 1
        if shown % 10 == 0 or shown == n:
          let text = {digits: line, count: shown} lineOf
          {text: text} printLine
          line = ""
        s = {s: s, d: d} eliminate

fn problemSize({argv: Seq[str]}) -> int:
  if argv.len > 0:
    let n = {t: argv[0]} parseInt
    if n.ok:
      return n.value ^int
  return 27

fn main() -> int [io: console, io: sys]:
  let argv = {} commandLine
  let n = {argv: argv} problemSize
  {n: n} digitsOf
  return 0
