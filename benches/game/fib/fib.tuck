# fib: naive doubly recursive Fibonacci; measures call overhead.
# Written plainly and NOT tuned.
import console
import convert
import cli
import seq
import str

fn fib({n: int}) -> int:
  if n < 2:
    return n
  let a = {n: n - 1} fib
  let b = {n: n - 2} fib
  return a + b

fn problemSize({argv: Seq[str]}) -> int:
  if argv.len > 0:
    let n = {t: argv[0]} parseInt
    if n.ok:
      return n.value ^int
  return 20

fn main() -> int [io: console, io: sys]:
  let argv = {} commandLine
  let n = {argv: argv} problemSize
  let r = {n: n} fib
  {text: r.toStr} printLine
  return 0
