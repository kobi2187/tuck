# lcs: the length of the longest common subsequence of two pseudo-random strings.
# Written plainly and NOT tuned.
import console
import convert
import cli
import seq
import str

fn randoms({n: int, seed: int, modulus: int}) -> Seq[int]:
  var out: Seq[int] = []
  var s = seed
  for i in 0 ..< n:
    s = (s * 1103515245 + 12345) % 2147483648
    out = {items: out, value: s % modulus} push
  return out

fn lcs({a: Seq[int], b: Seq[int]}) -> int:
  var prev: Seq[int] = []
  for j in 0 ..< b.len + 1:
    prev = {items: prev, value: 0} push
  for i in 1 ..< a.len + 1:
    var cur: Seq[int] = [0]
    for j in 1 ..< b.len + 1:
      var v = prev[j]
      if a[i - 1] == b[j - 1]:
        v = prev[j - 1] + 1
      else:
        if cur[j - 1] > v:
          v = cur[j - 1]
      cur = {items: cur, value: v} push
    prev = cur
  return prev[b.len]

fn problemSize({argv: Seq[str]}) -> int:
  if argv.len > 0:
    let n = {t: argv[0]} parseInt
    if n.ok:
      return n.value ^int
  return 500

fn main() -> int [io: console, io: sys]:
  let argv = {} commandLine
  let n = {argv: argv} problemSize
  let a = {n: n, seed: 3, modulus: 4} randoms
  let b = {n: n, seed: 5, modulus: 4} randoms
  let r = {a: a, b: b} lcs
  {text: r.toStr} printLine
  return 0
