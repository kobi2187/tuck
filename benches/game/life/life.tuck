# life: Conway's Game of Life on a torus of n by n cells, 100 generations; the live count.
# Written plainly and NOT tuned.
import console
import convert
import cli
import seq
import str

fn randoms({n: int, seed: int, modulus: int}) -> Seq[int]:
  var out: Seq[int] = []
  var s = seed
  for i in 0 ..< n:
    s = (s * 1103515245 + 12345) % 2147483648
    out = {items: out, value: s % modulus} push
  return out

fn neighbors({g: Seq[int], n: int, x: int, y: int}) -> int:
  var c = 0
  for dy in 0 ..< 3:
    for dx in 0 ..< 3:
      if dx != 1 or dy != 1:
        let xx = (x + dx + n - 1) % n
        let yy = (y + dy + n - 1) % n
        c = c + g[yy * n + xx]
  return c

fn step({g: Seq[int], n: int}) -> Seq[int]:
  var out: Seq[int] = []
  for y in 0 ..< n:
    for x in 0 ..< n:
      let c = {g: g, n: n, x: x, y: y} neighbors
      var alive = g[y * n + x]
      var next = 0
      if alive == 1 and (c == 2 or c == 3):
        next = 1
      if alive == 0 and c == 3:
        next = 1
      out = {items: out, value: next} push
  return out

fn population({g: Seq[int]}) -> int:
  var s = 0
  for x in g:
    s = s + x
  return s

fn problemSize({argv: Seq[str]}) -> int:
  if argv.len > 0:
    let n = {t: argv[0]} parseInt
    if n.ok:
      return n.value ^int
  return 64

fn main() -> int [io: console, io: sys]:
  let argv = {} commandLine
  let n = {argv: argv} problemSize
  var g = {n: n * n, seed: 9, modulus: 2} randoms
  for gen in 0 ..< 100:
    g = {g: g, n: n} step
  let r = {g: g} population
  {text: r.toStr} printLine
  return 0
