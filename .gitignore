tests/examples_out/
tests/temp_*
nimcache/
# `tuck build` pins Nim's cache next to its output so concurrent builds of
# same-named modules cannot collide in the shared ~/.cache/nim
.nimcache/
.claude/
tuck
.tuck-cache/
tests/beef_out/
tests/beef_backend
tests/auto_alias_out/
# emitted backend output lands next to the .tuck source
examples/*.nim
examples/*.odin
examples/*.bf
compiler/tuckrt/minicoro.a
tests/odin_out/
# `tuck build` drops binaries and copied deps beside the examples;
# run-all-tests.sh regenerates all of it on every run
examples/m_*
examples/cffi/*.o
examples/tuckrt/
examples/mod_*/
tests/.smoke_*
