tests/examples_out/
tests/temp_*
nimcache/
# `tuck build` pins Nim's cache next to its output so concurrent builds of
# same-named modules cannot collide in the shared ~/.cache/nim
.nimcache/
.claude/
tuck
.tuck-cache/
tests/beef_out/
tests/beef_backend
tests/auto_alias_out/
# Emitted backend output lands next to the .tuck source, and is TRACKED on
# purpose: the generated Nim, Odin and D is the compiler's real product, and
# keeping it in the tree is the only way a change to codegen is visible as a
# diff rather than something you have to run the compiler to notice.
#
# Regenerate with tools/emit_examples.sh. A commit touching codegen is expected
# to carry the re-emitted output with it — an unexpected diff there is the
# review signal.
#
# .bf (Beef) stays ignored: that backend is a ceiling experiment, not a product.
examples/*.bf
compiler/tuckrt/minicoro.a
tests/odin_out/
tests/escape_solver
tests/interface_repr_slice
compiler/escape
# `tuck build` drops binaries and copied deps beside the examples;
# run-all-tests.sh regenerates all of it on every run
examples/m_*
examples/cffi/*.o
examples/tuckrt/
examples/mod_*/
# D's runtime copies beside the emitted .d — flat files, not a directory
# (Odin's equivalent copy nests under examples/tuckrt/ above), but the same
# rationale: identical content regardless of which example produced it, so
# tracking it would be per-example noise, not per-example output.
examples/tuck_coro.d
examples/tuck_rt.d
examples/minicoro.a
tests/.smoke_*
tools/__pycache__/
tools/cyc

# The compiled test runner (from tests/runner.nim). Dot-prefixed so it cannot
# be mistaken for the entry point: `tests/run` is a tracked SCRIPT that builds
# this and execs it. It used to BE this binary, which meant a stale build was
# indistinguishable from a fresh one — you could edit a suite, run it, and be
# shown the previous version's result as green.
tests/.runner-bin
