# http — a library module: imported by 14-task.tuck, never compiled alone.
# Its one fn is pending: the walking skeleton runs, the TODO report nags.
#
# The enum is not decoration: a fn that raises must name what it can raise
# (TK-TY24), and `14-task` re-raises this one's codes, so it names it too.
type HttpError:
  | Unreachable
  | BadStatus

pending:
  fn get({url: str}) -> !{body: str} [io, error: HttpError]
