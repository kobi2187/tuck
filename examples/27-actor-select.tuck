# `on select` — an actor waits on receive branches (spec §9.3). Phase B:
# message arms with typed bindings + a reserved `shutdown` arm that stops the
# actor. (Timers/timeouts come in a later phase.)

import scheduler

actor Accumulator [queue: 64]:
  total: int = 0
  done: bool = false

  on select:
    | add -> {n: int}:  total += n
    | finish -> {}:     done = true
    | shutdown -> {}:   total = total

fn ready() -> bool:
  return Accumulator.done

fn main() -> int:
  for i in 1 .. 10:
    Accumulator send add {n: i}
  Accumulator send finish {}
  scheduler::waitUntil {pred: :ready}
  return Accumulator.total
