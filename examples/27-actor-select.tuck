# `on select` — an actor waits on receive branches (spec §9.3). Phase B:
# message arms with typed bindings. An arm is ONE line or ONE call, and void; an
# actor is a singleton server that lives as long as the program, so there is no
# shutdown arm. (Timers/timeouts come in a later phase.)

import scheduler

actor Accumulator [queue: 64]:
  total: int = 0
  done: bool = false

  on select:
    | add -> {n: int}:  total += n
    | finish -> {}:     done = true

fn ready() -> bool:
  return Accumulator.done

fn main() -> int:
  for i in 1 .. 10:
    Accumulator send add {n: i}
  Accumulator send finish {}
  Accumulator.waitUntil {pred: :ready}
  return Accumulator.total
