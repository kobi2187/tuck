# Actor model, lifecycle, and effect markers
type Feed:
  title: str
  episodeCount: int

actor Counter:
  count: int = 0

  on increment({n: int}):
    count += n

  # No return type: an actor message is fire-and-forget (spec 9.1), and
  # there is no reply channel yet. A caller reads the public field instead:
  # `Counter.count`.
  on reset():
    count = 0

fn readSensor({port: u8}) -> !{value: u16} [io]:
  ...

object PodcastApp:
  pending:
    fn fetchFeed({url: str}) -> !{feed: Feed} [io]
