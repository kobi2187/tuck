# Task that RUNS and RETURNS — spec §9.2. A task is an async coroutine: [io]
# calls are implicit yield points (the effect marker IS the async annotation —
# no async/await keyword). Calling a task schedules it; binding its result
# awaits completion. It looks exactly like a synchronous call.

fn stepIo({n: int}) -> {v: int} [io]:
  return {v: n}                 # stands in for a real async I/O op

task compute({base: int}) -> {r: int} [io]:
  let a = {n: base} stepIo      # [io] -> yield
  let b = {n: base} stepIo      # [io] -> yield
  return {r: a.v + b.v}         # base*2

fn main() -> int:
  let res = {base: 21} compute  # schedule + await the task's result
  return res.r                  # 42
