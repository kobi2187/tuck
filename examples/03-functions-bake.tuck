# `bake` — partial application (Factor-style fry).
# A struct is the fn's context. bake FIXES a slot to a value: a fn
# reference (:name) or an argument value, so callers downstream no longer
# supply it. Fixing the fn reference is what narrows the call — once `op`
# is set, the context is invoked with just its value fields.
# The slot stays in the struct carrying its value; nothing is removed.
# A fnsig field emits as a closure proc value, so the call through a baked
# slot is indirect. Monomorphizing it is an open optimization.

fnsig BinOp = {a: int, b: int} -> int

fn plus({a: int, b: int}) -> int:
  return a + b

fn applyOperation({a: int, b: int, op: BinOp}) -> int:
  op.invoke {a, b}

fn main() -> void:
  let x = {a: 5, b: 10}
  let withOp = x bake {op: :plus}   # fill the fn slot
  let smaller = withOp bake {b: 2} # bake argument values too
  let r = smaller applyOperation
  return
