import net
import scheduler

# Server and client in ONE program over real TCP on loopback. Binding a task's
# result AWAITS it (spec §9.2), so the server must not be bound before the
# client runs — an actor holds the result instead, and main waits on its state.
actor Result [queue: 8]:
  code: int = 0
  ready: bool = false

  on put({c: int}):
    code = c
    ready = true

task serve({lfd: int}) -> void [io]:
  let c = {fd: lfd} net::accept
  if c.ok:
    # Both results are deliberately ignored here: the server answers once and
    # closes, so a failed read or write has nowhere to be reported to. Saying
    # so with `discard` is the point — binding and ignoring would say nothing
    # (TK-TY25).
    {fd: c.value.fd, max: 256} net::recv discard
    {fd: c.value.fd, data: "pong"} net::send discard
    {fd: c.value.fd} net::close
  return

task client({port: int}) -> void [io]:
  let c = {host: "127.0.0.1", port: port} net::connect
  if c.ok:
    {fd: c.value.fd, data: "ping"} net::send discard
    let r = {fd: c.value.fd, max: 256} net::recv
    {fd: c.value.fd} net::close
    if r.ok:
      if r.value.data == "pong":
        Result send put {c: 42}
        return
    Result send put {c: 3}
    return
  Result send put {c: 4}
  return

fn done() -> bool:
  return Result.ready

fn main() -> int [io]:
  let l = {port: 34593} net::listen
  if l.ok:
    {lfd: l.value.fd} serve      # fire-and-forget: not bound, so not awaited
    {port: 34593} client
    scheduler::waitUntil {pred: :done}
    {fd: l.value.fd} net::close
    {} scheduler::stop
    return Result.code
  return 1
