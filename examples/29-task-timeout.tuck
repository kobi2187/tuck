# Operation timeout — spec §9.3. A task races an async I/O read against a
# deadline with `on select`: whichever is ready first wins. This is the thing
# that is impossible on blocking I/O — the timeout fires WHILE the read is
# outstanding, because the [io] op is non-blocking (reactor + coroutine).

import time

extern:
  fn openSource({ms: int}) -> {fd: int} [io]   # an async read source

task readOrGiveUp({fd: int}) -> {code: int} [io]:
  on select:
    | read fd          -> {}:  return {code: 1}   # data arrived first
    | timeout {30.ms}  -> {}:  return {code: 2}   # 30ms deadline fired first

fn main() -> int:
  let src = {ms: 500} openSource       # data really arrives after 500ms
  let r = {fd: src.fd} readOrGiveUp    # 30ms timeout wins first -> code 2
  return r.code
