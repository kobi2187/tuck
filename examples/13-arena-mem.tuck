# An arena: one lifetime over everything a stretch of work allocates
# (thoughts/shared/plans/2026-09-29-slab-proposal.md §9).
#
# Per-packet scratch space is the classic case. Each packet's work allocates
# a handful of values that point at each other, all of which die together
# when the packet is done. Freeing them one by one is bookkeeping with
# nothing to gain; an arena frees them all at once:
#
#   ScratchSpace.new {value: v}   a cell for v, of v's type — a
#                                 ScratchSpaceRef[T], or `?` of one under a
#                                 `[size: N]` budget: absent once spent
#   r.field                       read or write through the reference
#   ScratchSpace.reset            everything, gone in O(1); the budget back
#
# There is no per-cell free — that is what makes it an arena. A reference
# kept past a `reset` is stale, and using one stops the program with
# "TUCK SLAB [ScratchSpace]: stale reference" instead of reading reused
# memory. The arena is a declaration, not a block: it lives as long as the
# program, and `reset` is called wherever a batch of work ends.
#
# The budget is in bytes the COMPILER counts from each Tuck type — the same
# on every backend, so `new` runs out at the same point on all three.

type EthernetFrame:
  len: int
  bytes: Array[128, u8]

type Header:
  len: int
  frame: ScratchSpaceRef[EthernetFrame]     # a reference into the arena

arena ScratchSpace [size: 2048]

fn handle({len: int}) -> int:
  # One packet: a frame and a header pointing at it, both in the arena.
  let raw: Array[128, u8] = [0; 128]
  let f = {len: len, bytes: raw} EthernetFrame
  let fr = ScratchSpace.new {value: f}
  if not fr.ok:
    return 0                       # budget spent: the caller decides
  let h = {len: len, frame: fr.value} Header
  let hr = ScratchSpace.new {value: h}
  if not hr.ok:
    return 0
  hr.value.frame.len += 1          # through two references, one cell
  return hr.value.frame.len

fn main() -> int:
  var handled = 0
  var i = 0
  for i < 5:
    handled = handled + {len: 10} handle
    i = i + 1
  # 5 packets of 144 + 24 bytes each fit the 2048-byte budget; the budget
  # is not unlimited, though: keep allocating without a reset and `new` is
  # absent. One reset gives it all back.
  ScratchSpace.reset
  return handled                   # 5 × 11 = 55
