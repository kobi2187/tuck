# Spawn + await a task that makes two [io] calls, M times. Baseline for the
# stackless spike (research/stackless/README.md).
fn stepIo({n: int}) -> {v: int} [io]:
  return {v: n}

task compute({base: int}) -> {r: int} [io]:
  let a = {n: base} stepIo
  let b = {n: base} stepIo
  return {r: a.v + b.v}

fn main() -> int [io]:
  var sum = 0
  var i = 0
  for i < 1000000:
    let res = {base: 1} compute
    sum += res.r
    i += 1
  if sum == 2000000:
    return 0
  return 1
