# FizzBuzz 1..20
import io

fn main() -> void [io]:
  for i in 1 .. 20:
    if i % 15 == 0:
      {text: "FizzBuzz"} printLine
    else:
      if i % 3 == 0:
        {text: "Fizz"} printLine
      else:
        if i % 5 == 0:
          {text: "Buzz"} printLine
        else:
          {value: i} toStr printLine
  return
