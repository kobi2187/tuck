# Join two collections on a key (customers with their orders)
import io
import seq

type Customer:
  id: int
  name: str

type Order:
  customerId: int
  total: int

type CustomerOrder:
  name: str
  total: int

pending:
  fn joinOn({customers: Seq[Customer], orders: Seq[Order]}) -> Seq[CustomerOrder]

fn main() -> void [io]:
  let customers = [{id: 1, name: "Ada"} Customer, {id: 2, name: "Bo"} Customer]
  let orders = [{customerId: 1, total: 50} Order, {customerId: 2, total: 30} Order]
  let joined = {customers, orders} joinOn
  for row in joined:
    {value: row.total} toStr printLine
  return
