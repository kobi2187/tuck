# Flatten a small nested (2D) list into a flat buffer
import io
import seq

fn main() -> void [io]:
  let rows = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
  var flat = [0, 0, 0, 0, 0, 0, 0, 0, 0]
  var i = 0
  for row in rows:
    for n in row:
      flat[i] = n
      i = i + 1
  for n in flat:
    {value: n} toStr printLine
  return
