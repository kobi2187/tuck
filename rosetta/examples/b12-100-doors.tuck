# 100 doors puzzle: toggle each door's state, print open doors
import io
import seq

fn main() -> void [io]:
  var doors = [false, false, false, false, false, false, false, false, false, false]
  for pass in 1 .. 10:
    for i in 0 ..< 10:
      if (i + 1) % pass == 0:
        doors[i] = not doors[i]
  for i in 0 ..< 10:
    if doors[i]:
      {value: i + 1} toStr printLine
  return
