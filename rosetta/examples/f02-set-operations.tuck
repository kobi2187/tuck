# Set operations: union, intersect, distinct over two lists
import io
import seq

pending:
  fn union({a: Seq[int], b: Seq[int]}) -> Seq[int]
  fn intersect({a: Seq[int], b: Seq[int]}) -> Seq[int]
  fn distinctValues({items: Seq[int]}) -> Seq[int]

fn main() -> void [io]:
  let a = [1, 2, 3, 4]
  let b = [3, 4, 5, 6]
  let both = {a, b} union
  let common = {a, b} intersect
  let uniq = {items: both} distinctValues
  {value: uniq.len} toStr printLine
  {value: common.len} toStr printLine
  return
