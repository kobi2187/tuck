# rs12 — loop:/break/continue, while-style for, nested if/else (no elif).
# Stresses: infinite loop with break, continue, nested if chain replacing elif.
import io

fn classify({n: int}) -> str:
  if n < 0:
    "negative"
  else:
    if n == 0:
      "zero"
    else:
      "positive"

fn main() -> void [io]:
  var i = 0
  var sum = 0
  loop:
    i = i + 1
    if i > 10:
      break
    if i % 2 == 0:
      continue
    sum = sum + i
  {value: sum} toStr printLine
  {text: {n: sum} classify} printLine
  return
