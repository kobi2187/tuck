# rs07 — long postfix chains, chained indexing, indexed write mutation.
# Stresses: multi-hop postfix, xs[i] read/write, .len chained.
import io
import seq

fn main() -> void [io]:
  var xs = [3, 1, 4, 1, 5]
  xs[0] = xs[1] + xs[2]
  let n = xs.len
  let last = xs[n - 1]
  {value: last} toStr printLine
  {value: xs[0]} toStr printLine
  return
