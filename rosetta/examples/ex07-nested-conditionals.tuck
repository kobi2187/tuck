# Nested if/else (no elif) approximating Elixir's cond, 3 levels deep
import io

fn classify({n: int}) -> str:
  if n < 0:
    return "negative"
  else:
    if n == 0:
      return "zero"
    else:
      if n < 10:
        return "small"
      else:
        if n < 100:
          return "medium"
        else:
          return "large"

fn main() -> void [io]:
  {text: {n: -5} classify} printLine
  {text: {n: 0} classify} printLine
  {text: {n: 7} classify} printLine
  {text: {n: 42} classify} printLine
  {text: {n: 9000} classify} printLine
  return
