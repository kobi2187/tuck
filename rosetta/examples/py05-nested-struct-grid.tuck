# deeply nested struct literals; chained indexing grid[i][j]
import io
import seq

type Cell:
  row: int
  col: int
  tag: str

type Grid:
  origin: Cell
  size: int

fn main() -> void [io]:
  let g = {origin: {row: 0, col: 0, tag: "start"} Cell, size: 3} Grid
  let rows = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
  let picked = rows[g.origin.row][g.origin.col + 1]
  {value: picked} toStr printLine
  {text: g.origin.tag} printLine
  return
