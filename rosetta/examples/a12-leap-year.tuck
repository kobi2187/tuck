# Leap year check
import io

fn main() -> void [io]:
  let year = 2024
  var isLeap = false
  if year % 4 == 0:
    if year % 100 == 0:
      if year % 400 == 0:
        isLeap = true
      else:
        isLeap = false
    else:
      isLeap = true
  else:
    isLeap = false
  if isLeap:
    {text: "leap year"} printLine
  else:
    {text: "not a leap year"} printLine
  return
