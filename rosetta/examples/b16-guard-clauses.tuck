# Guard clauses: bail out early instead of nesting deeply
import io

fn classify({n: int}) -> str:
  if n < 0:
    return "negative"
  elif n == 0:
    return "zero"
  return "positive"

fn main() -> void [io]:
  {text: {n: -5} classify} printLine
  {text: {n: 0} classify} printLine
  {text: {n: 5} classify} printLine
  return
